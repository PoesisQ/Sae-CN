// Nimbus Roman outlines. The narrow opposing ink protects hairlines over a mixed field.
export component Wordmark inherits Path {
    in property <bool> pale;
    accessible-role: text; accessible-label: "Sae";
    viewbox-width: 1395; viewbox-height: 753;
    fill: root.pale ? #fffaf0 : #111e25;
    stroke: root.pale ? #12202b9e : #fff7e999; stroke-width: 0.65px;
