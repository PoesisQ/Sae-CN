// The document owns the canvas. Location and scale share one low rail, with
// document controls available at its edges. Opening a book is the primary
// action when the canvas is empty. Group spacing uses 4/8/12/16/24px (§3.2, §3.6).
// In both palettes, a thin highlight and a solid contact edge separate raised
// controls from the canvas. Recessed controls use the darker well (§6.1, §6.4).
import { LineEdit, ComboBox, ScrollView, ListView, Palette } from "std-widgets.slint";

export struct Mark { x:float, y:float, w:float, h:float }
export struct PageTile { source:image, w:float, h:float, selection:[Mark], matches:[Mark] }
export struct TocRow { title:string, uri:string, depth:int, latin:bool }

export global ReaderTheme {
    in-out property <bool> dark: false;
    in-out property <color> paper: #f8f6f1;
    out property <color> chrome: dark ? #232927 : #efefe9;
    out property <color> ink: dark ? #e9ece9 : #262c29;
    out property <color> muted: dark ? #b2bdb7 : #5a655e;
    out property <color> line: dark ? #48534c : #d7dbd3;
    out property <color> accent: dark ? #a9c5b7 : #46675c;
    out property <color> tint: dark ? #a9c5b71f : #46675c18;
    out property <color> surface: dark ? #2c3430 : #fbfaf6;
    out property <color> well: dark ? #1c2320 : #ebede6;
    out property <color> edge: dark ? #58645e : #fffffc;
    out property <color> contact: dark ? #0d121075 : #293e342d;
    out property <color> invalid: dark ? #f0ae9a : #9a4238;
    out property <length> pad: 16px;
    out property <length> radius: 6px;
    out property <length> contact-depth: 3px;
}

component QuietButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <string> label: root.text;
    in property <color> swatch: transparent;
    in property <bool> selected: false;
    in property <bool> compact-selection: false;
    in property <bool> left-aligned: false;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 32px; min-width: 32px;
    preferred-width: root.text == "" ? 36px : caption.preferred-width + 24px + (root.icon.width > 0 || root.swatch.alpha > 0 ? 24px : 0px);
    horizontal-stretch: 0;
    border-radius: ReaderTheme.radius;
    background: root.primary ? (touch.pressed ? ReaderTheme.tint : ReaderTheme.well)
        : touch.pressed ? ReaderTheme.well : root.selected || touch.has-hover ? ReaderTheme.tint : transparent;
    border-width: focus.has-focus || root.primary ? 1px : 0px;
    border-color: focus.has-focus ? ReaderTheme.accent : ReaderTheme.line;
    opacity: root.enabled ? 1 : 0.4;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    caption := Text {
        visible: root.text != "";
        text: root.text;
        x: root.icon.width > 0 ? 36px : root.swatch.alpha > 0 ? 24px : root.left-aligned ? 16px : 0px;
        width: max(0px,parent.width - self.x - (root.left-aligned ? 8px : 0px));
        color: root.selected ? ReaderTheme.accent : ReaderTheme.ink;
        font-size: 13px; font-weight: root.selected || root.primary ? 600 : 400;
        min-width: 0px; overflow: elide;
        horizontal-alignment: root.left-aligned ? left : center; vertical-alignment: center;
    }
    if root.swatch.alpha > 0: Rectangle {
        x: 10px; y: (parent.height - self.height) / 2; width: 12px; height: 16px;
        border-radius: 2px; border-width: 1px; border-color: ReaderTheme.line; background: root.swatch;
    }
    if root.icon.width > 0: Image {
        x: root.text == "" ? (parent.width - 18px) / 2 : 12px; y: (parent.height - 18px) / 2;
        width: 18px; height: 18px; source: root.icon;
        colorize: root.selected ? ReaderTheme.accent : ReaderTheme.muted;
    }
    if root.compact-selection && root.selected: Rectangle {
        x: 4px; y: (parent.height - self.height) / 2; width: 2px; height: 12px;
        background: ReaderTheme.accent;
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                if root.enabled { root.clicked(); } return accept;
            }
            return reject;
        }
    }
    touch := TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.clicked(); } }
}

component RaisedPanel inherits Rectangle {
    // A short solid shadow remains cheap in the software renderer (§6.4.2).
    Rectangle { y: ReaderTheme.contact-depth; width: parent.width; height: parent.height; border-radius: ReaderTheme.radius; background: ReaderTheme.contact; }
    Rectangle {
        width: parent.width; height: parent.height; border-radius: ReaderTheme.radius;
        border-width: 1px; border-color: ReaderTheme.line; background: ReaderTheme.surface;
        Rectangle { x: ReaderTheme.radius; y: 1px; width: parent.width - 2 * self.x; height: 1px; background: ReaderTheme.edge; }
    }
    TouchArea {}
    @children
}

component PanelHeading inherits Rectangle {
    in property <string> title;
    in property <image> icon;
    callback closed();
    x: 0px; y: 0px; height: 52px;
    Rectangle { x: 1px; y: 2px; width: parent.width - 2px; height: parent.height - 2px; background: ReaderTheme.chrome; border-top-left-radius: 4px; border-top-right-radius: 4px; }
    Rectangle { x: ReaderTheme.pad; y: parent.height - 1px; width: parent.width - 2 * self.x; height: 1px; background: ReaderTheme.line; }
    Image { x: ReaderTheme.pad; y: 18px; width: 16px; height: 16px; source: root.icon; colorize: ReaderTheme.muted; }
    Text {
        x: 40px; y: 0px; width: parent.width - 88px; height: parent.height;
        text: root.title; font-size: 16px; font-weight: 600; color: ReaderTheme.ink;
        vertical-alignment: center; overflow: elide;
    }
    QuietButton { x: parent.width - 44px; y: 10px; width: 32px; icon: @image-url("../assets/icons/close.svg"); label: "收起"; clicked => { root.closed(); } }
}

component GroupLabel inherits Text {
    color: ReaderTheme.muted;
    font-size: 12px;
    font-weight: 600;
    height: 20px;
    vertical-alignment: center;
}

component PanelToggle inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled();
    function flip() { root.checked = !root.checked; root.toggled(); }
    height: 32px; min-width: caption.preferred-width + 54px;
    border-radius: ReaderTheme.radius;
    border-width: focus.has-focus ? 1px : 0px;
    border-color: ReaderTheme.accent;
    background: touch.has-hover ? ReaderTheme.tint : transparent;
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.flip(); }
    forward-focus: focus;
    Rectangle {
        x: 4px; y: 7px; width: 32px; height: 18px; border-radius: 9px;
        background: root.checked ? ReaderTheme.accent : ReaderTheme.well;
        border-width: 1px; border-color: root.checked ? ReaderTheme.accent : ReaderTheme.line;
        Rectangle {
            x: root.checked ? 17px : 3px; y: 3px; width: 12px; height: 12px;
            border-radius: 6px; background: root.checked ? ReaderTheme.surface : ReaderTheme.muted;
        }
    }
    caption := Text {
        x: 44px; y: 0px; height: parent.height; text: root.text;
        color: ReaderTheme.ink; font-size: 13px; vertical-alignment: center;
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.flip(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.flip(); } }
}

component SettingField inherits Rectangle {
    in property <string> label;
    in property <string> unit;
    in property <float> minimum;
    in property <float> maximum;
    in property <float> step: root.unit == "px" ? 4 : root.unit == "pt" ? 1 : 0.05;
    in-out property <float> value;
    in property <bool> enabled: true;
    callback edited(float);
    callback entered(string);
    height: 40px;
    opacity: root.enabled ? 1 : 0.45;
    function set-value(value: float) {
        let next = clamp(value,root.minimum,root.maximum);
        if next != root.value { root.value = next; root.edited(next); }
    }
    // A label, rail and value share a single row so paragraphs and margins
    // read as related adjustments inside each group (§3.3, §3.6, §4.4).
    HorizontalLayout {
        spacing: 8px;
        Text { width: 64px; text: root.label; color: ReaderTheme.ink; font-size: 13px; vertical-alignment: center; }
        Rectangle {
            height: 32px; horizontal-stretch: 1; border-radius: ReaderTheme.radius;
            border-width: slider-focus.has-focus ? 1px : 0px; border-color: ReaderTheme.accent;
            accessible-role: slider; accessible-label: root.label; accessible-enabled: root.enabled;
            accessible-value: root.value; accessible-value-minimum: root.minimum; accessible-value-maximum: root.maximum;
            accessible-value-step: root.step;
            accessible-action-set-value(v) => { if root.enabled && v.is-float() { root.set-value(v.to-float()); } }
            accessible-action-increment => { if root.enabled { root.set-value(root.value + root.step); } }
            accessible-action-decrement => { if root.enabled { root.set-value(root.value - root.step); } }
            forward-focus: slider-focus;
            rail := Rectangle {
                x: 8px; y: (parent.height - self.height) / 2; width: parent.width - 16px; height: 2px;
                border-radius: 1px; background: ReaderTheme.line;
                Rectangle { x: 0px; y: 0px; width: thumb.x - parent.x + 6px; height: parent.height; border-radius: 1px; background: ReaderTheme.accent; }
            }
            thumb := Rectangle {
                x: rail.x + rail.width * clamp((root.value - root.minimum) / (root.maximum - root.minimum),0,1) - 6px;
                y: (parent.height - self.height) / 2; width: 12px; height: 12px; border-radius: 6px; background: ReaderTheme.accent;
                border-width: 2px; border-color: ReaderTheme.surface;
            }
            slider-focus := FocusScope {
                enabled: root.enabled;
                key-pressed(event) => {
                    if event.text == Key.LeftArrow { root.set-value(root.value - root.step); return accept; }
                    if event.text == Key.RightArrow { root.set-value(root.value + root.step); return accept; }
                    if event.text == Key.Home { root.set-value(root.minimum); return accept; }
                    if event.text == Key.End { root.set-value(root.maximum); return accept; }
                    return reject;
                }
            }
            TouchArea {
                enabled: root.enabled; mouse-cursor: pointer;
                function seek() { root.set-value(root.minimum + (root.maximum - root.minimum) * ((self.mouse-x - rail.x) / rail.width)); }
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left { slider-focus.focus(); self.seek(); }
                }
                moved => { if self.pressed { self.seek(); } }
            }
        }
        LineEdit {
            width: 52px; height: 32px; enabled: root.enabled;
            text: "" + (round(root.value * 100) / 100);
            accepted => { root.entered(self.text); }
        }
        Text { width: 24px; text: root.unit; color: ReaderTheme.muted; font-size: 11px; vertical-alignment: center; }
    }
}

component PagePane inherits Rectangle {
    in property <image> source;
    in property <float> page-width;
    in property <float> page-height;
    in property <[Mark]> selection;
    in property <[Mark]> matches;
    in property <int> turn-mode: 0;
    in property <int> join-edge: 0;
    in property <bool> pannable: false;
    callback select-text(float,float,float,float);
    callback hit(float,float);
    callback wheel(float);
    callback pan(float,float);
    callback wheel-xy(float,float,bool,bool);
    callback navigate(int);
    min-width: 0px; min-height: 0px;
    preferred-width: 0px; preferred-height: 0px;
    horizontal-stretch: 1; vertical-stretch: 1;
    clip: true;
    TouchArea {
        clicked => { root.navigate(root.turn-mode != 0 ? root.turn-mode : self.mouse-x < self.width / 2 ? -1 : 1); }
        scroll-event(event) => { root.wheel-xy(event.delta-x / 1px,event.delta-y / 1px,event.modifiers.shift,event.modifiers.control); return accept; }
    }
    image := Image {
        x: root.join-edge < 0 ? parent.width - self.width : root.join-edge > 0 ? 0px : (parent.width - self.width) / 2;
        y: max(0px, (parent.height - self.height) / 2);
        width: root.page-width * 1px; height: root.page-height * 1px;
        source: root.source; image-fit: contain;
        for mark in root.matches: Rectangle {
            x: mark.x * 1px; y: mark.y * 1px; width: mark.w * 1px; height: mark.h * 1px;
            background: #c9aa3658;
        }
        for mark in root.selection: Rectangle {
            x: mark.x * 1px; y: mark.y * 1px; width: mark.w * 1px; height: mark.h * 1px;
            background: #648d7855;
        }
        touch := TouchArea {
            property <float> start-x;
            property <float> start-y;
            property <bool> dragging-pan;
            property <float> last-x;
            property <float> last-y;
            mouse-cursor: self.dragging-pan ? grabbing : default;
            pointer-event(event) => {
                if event.kind == PointerEventKind.cancel { self.dragging-pan = false; }
                if event.kind == PointerEventKind.down && (event.button == PointerEventButton.middle || event.button == PointerEventButton.right) && root.pannable {
                    self.dragging-pan = true;
                    self.last-x = self.mouse-x / 1px; self.last-y = self.mouse-y / 1px;
                }
                if event.kind == PointerEventKind.up && (event.button == PointerEventButton.middle || event.button == PointerEventButton.right) { self.dragging-pan = false; }
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    self.start-x = self.mouse-x / 1px; self.start-y = self.mouse-y / 1px;
                }
                if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                    if abs(self.mouse-x / 1px - self.start-x) + abs(self.mouse-y / 1px - self.start-y) < 4 {
                        root.hit(self.mouse-x / 1px,self.mouse-y / 1px);
                    } else {
                        root.select-text(self.start-x,self.start-y,self.mouse-x / 1px,self.mouse-y / 1px);
                    }
                }
            }
            moved => {
                if self.dragging-pan {
                    root.pan(self.last-x - self.mouse-x / 1px,self.last-y - self.mouse-y / 1px);
                    self.last-x = self.mouse-x / 1px; self.last-y = self.mouse-y / 1px;
                }
            }
            scroll-event(event) => { root.wheel-xy(event.delta-x / 1px,event.delta-y / 1px,event.modifiers.shift,event.modifiers.control); return accept; }
        }
    }
}

component DialFace inherits Rectangle {
    in property <angle> turn;
    in property <bool> pressed: false;
    in property <bool> large: false;
    height: self.width;
    border-radius: self.width / 2;
    background: ReaderTheme.contact;
    // A recessed edge and a small highlight give the round face a grip.
    // Only the engraved mark moves. The surrounding surface stays in place.
    Rectangle {
        x: 1px; y: root.pressed && root.large ? 2px : 0px;
        width: parent.width - 2px; height: self.width;
        border-radius: self.width / 2;
        border-width: 1px; border-color: ReaderTheme.line;
        background: ReaderTheme.edge;
        if root.large: Rectangle {
            x: 4px; y: 3px; width: parent.width - 8px; height: self.width;
            border-radius: self.width / 2; border-width: 1px;
            border-color: ReaderTheme.line;
            background: ReaderTheme.chrome;
            Rectangle {
                x: 2px; y: 1px; width: parent.width - 4px; height: self.width;
                border-radius: self.width / 2;
                background: ReaderTheme.surface;
            }
        }
        Path {
            width: parent.width; height: parent.height;
            viewbox-width: self.width / 1px; viewbox-height: self.height / 1px;
            property <float> center: self.width / 2px;
            property <float> outer: self.center - (root.large ? 9 : 3);
            property <float> inner: self.outer - (root.large ? 12 : 5);
            stroke: ReaderTheme.accent;
            stroke-width: root.large ? 3px : 1.5px;
            MoveTo {
                x: parent.center + sin(root.turn) * parent.inner;
                y: parent.center - cos(root.turn) * parent.inner;
            }
            LineTo {
                x: parent.center + sin(root.turn) * parent.outer;
                y: parent.center - cos(root.turn) * parent.outer;
            }
        }
    }
}

component ZoomKnob inherits Rectangle {
    in property <float> value: 1;
    in property <bool> large: false;
    in property <bool> dragging: false;
    callback stepped(float);
    callback started();
    callback travelled(float);
    callback released(float,float);
    callback cancelled();
    callback opened();
    // Fit Page is at twelve o'clock. The end positions never wrap.
    property <angle> angle: 50deg * log(clamp(root.value,0.25,8),2);
    animate angle { duration: root.dragging ? 0ms : 85ms; easing: ease-out; }
    forward-focus: dial-focus;
    accessible-role: slider; accessible-label: "PDF 缩放";
    accessible-value: round(root.value * 100) + "%";
    accessible-action-increment => { root.stepped(1); }
    accessible-action-decrement => { root.stepped(-1); }

    DialFace {
        x: root.large ? (parent.width - self.width) / 2 : 4px;
        y: (parent.height - self.height) / 2;
        width: root.large ? 76px : 24px;
        large: root.large;
        pressed: touch.pressed;
        turn: root.angle;
    }
    if !root.large: Text {
        x: 34px; y: 0px; width: parent.width - self.x - 8px; height: parent.height;
        text: round(root.value * 100) + "%";
        color: touch.has-hover || root.dragging ? ReaderTheme.accent : ReaderTheme.ink;
        font-family: "Segoe UI"; font-size: 14px; font-weight: 600;
        horizontal-alignment: right; vertical-alignment: center;
    }
    if dial-focus.has-focus: Rectangle {
        x: root.large ? (parent.width - self.width) / 2 : parent.width - self.width - 4px;
        y: parent.height - 4px; width: 16px; height: 1px;
        background: ReaderTheme.accent;
    }
    dial-focus := FocusScope {
        key-pressed(e) => {
            if e.text == Key.UpArrow { root.stepped(1); return accept; }
            if e.text == Key.DownArrow { root.stepped(-1); return accept; }
            if e.text == Key.Return || e.text == " " { root.opened(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        property <float> start-x;
        property <float> start-y;
        property <int> axis;
        function update-drag() {
            // Choose a direction once. Absolute travel makes small and large
            // mouse events equivalent and lets a reversal retrace the same path.
            let dx = self.mouse-x / 1px - self.start-x;
            let dy = self.start-y - self.mouse-y / 1px;
            if self.axis == 0 && max(abs(dx),abs(dy)) >= 4 {
                self.axis = abs(dx) >= abs(dy) ? 1 : 2;
            }
            if self.axis != 0 { root.travelled(self.axis == 1 ? dx : dy); }
        }
        mouse-cursor: self.pressed ? grabbing : grab;
        pointer-event(e) => {
            if e.kind == PointerEventKind.cancel { root.cancelled(); }
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                self.axis = 0;
                self.start-x = self.mouse-x / 1px; self.start-y = self.mouse-y / 1px;
                root.started();
            }
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                self.update-drag();
                if self.axis == 0 && self.has-hover && !root.large { root.opened(); }
                root.released((self.absolute-position.x + self.mouse-x) / 1px,
                              (self.absolute-position.y + self.mouse-y) / 1px);
            }
        }
        moved => { if self.pressed { self.update-drag(); } }
        scroll-event(e) => { if e.delta-y != 0px { root.stepped(e.delta-y / 120px); } return accept; }
    }
}

component PageScrubber inherits Rectangle {
    in property <int> first;
    in property <int> last;
    in property <int> total;
    in property <bool> editing;
    callback jump(string) -> bool;
    callback edit();
    callback turned(int);
    callback active(bool);
    out property <int> preview-page: touch.pressed ? round(root.preview * max(0,root.total - 1)) + 1 : 0;
    property <float> preview;
    property <float> progress: touch.pressed ? root.preview : clamp((root.first - 1) / max(1,root.total - 1),0,1);
    property <string> current: root.preview-page > 0 ? "" + root.preview-page : root.last > root.first ? root.first + "–" + root.last : "" + root.first;
    property <string> total-text: "/ " + (root.total > 0 ? "" + root.total : "…");
    property <string> label: root.current + " " + root.total-text;
    // Reserve room for the longest visible range in this book. Seeking does
    // not move the beginning of the track when the page number gains a digit.
    property <length> folio-width: root.total < 100 ? 68px : root.total < 1000 ? 84px : root.total < 10000 ? 104px : root.total < 100000 ? 128px : 184px;
    property <length> number-width: root.folio-width - limit.preferred-width - 6px;
    property <bool> invalid: false;
    function activate-entry() {
        if root.editing {
            entry.text = "" + root.first;
            root.invalid = false;
            entry.focus(); entry.select-all();
        }
    }
    init => { root.activate-entry(); }
    changed editing => { root.activate-entry(); }
    height: 32px;
    Text {
        x: 0px; y: 0px; width: root.number-width; height: parent.height;
        text: root.current; visible: !root.editing;
        font-family: "Segoe UI"; font-size: 13px; font-weight: 600;
        color: root.preview-page > 0 ? ReaderTheme.accent : ReaderTheme.ink;
        horizontal-alignment: right; vertical-alignment: center;
    }
    entry := TextInput {
        x: 0px; y: 0px; width: root.number-width; height: parent.height; visible: root.editing;
        single-line: true; input-type: number;
        font-family: "Segoe UI"; font-size: 13px; font-weight: 600; color: ReaderTheme.ink;
        horizontal-alignment: right; vertical-alignment: center;
        selection-background-color: ReaderTheme.accent.with-alpha(0.2); selection-foreground-color: ReaderTheme.ink;
        accessible-label: "输入页码，1 至 " + root.total;
        edited => { root.invalid = false; }
        accepted => { root.invalid = !root.jump(self.text); if root.invalid { self.select-all(); } }
    }
    limit := Text {
        x: root.number-width + 6px; y: 0px; height: parent.height;
        text: root.total-text; font-family: "Segoe UI"; font-size: 13px;
        color: ReaderTheme.muted; vertical-alignment: center;
    }
    if root.editing || page-button.has-hover || page-focus.has-focus: Rectangle {
        x: root.number-width - self.width; y: parent.height - 7px;
        width: min(root.number-width,16px); height: 1px;
        background: root.editing && root.invalid ? ReaderTheme.invalid : ReaderTheme.accent;
    }
    page-focus := FocusScope {
        x: 0px; y: 0px; width: root.folio-width; height: parent.height;
        enabled: !root.editing && root.total > 0;
        key-pressed(e) => {
            if e.text == Key.Return || e.text == " " { root.edit(); return accept; }
            return reject;
        }
    }
    page-button := TouchArea {
        x: 0px; y: 0px; width: root.folio-width; height: parent.height;
        enabled: !root.editing && root.total > 0;
        mouse-cursor: pointer;
        accessible-role: button; accessible-enabled: self.enabled; accessible-label: root.label + "，输入页码跳转";
        accessible-action-default => { if self.enabled { root.edit(); } }
        clicked => { root.edit(); }
    }
    track := Rectangle {
        x: root.folio-width + 12px; y: (parent.height - 1px) / 2; width: max(8px,parent.width - self.x - 8px); height: 1px;
        background: ReaderTheme.line;
        Rectangle { x: 0px; y: 0px; width: parent.width * root.progress; height: 1px; background: ReaderTheme.accent; }
        if root.total > 0: Rectangle {
            x: parent.width * root.progress - self.width / 2; y: (parent.height - self.height) / 2;
            width: 2px; height: touch.pressed ? 12px : 8px; background: ReaderTheme.accent;
        }
    }
    touch := TouchArea {
        x: track.x - 6px; y: 0px; width: parent.width - self.x;
        enabled: root.total > 1 && !root.editing; mouse-cursor: pointer;
        accessible-role: slider; accessible-label: "阅读进度"; accessible-value: root.label;
        accessible-action-increment => { root.turned(1); }
        accessible-action-decrement => { root.turned(-1); }
        function fraction() -> float { return clamp((self.mouse-x - 6px) / track.width,0,1); }
        pointer-event(e) => {
            if e.kind == PointerEventKind.cancel { root.active(false); }
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.active(true); root.preview = self.fraction();
            }
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                let page = round(self.fraction() * (root.total - 1)) + 1;
                root.jump("" + page); root.active(false);
            }
        }
        moved => { if self.pressed { root.preview = self.fraction(); } }
        scroll-event(e) => { if e.delta-y != 0px { root.turned(e.delta-y < 0px ? 1 : -1); } return accept; }
    }
}

export component ReaderWindow inherits Window {
    title: root.book-title == "" ? "Sae Reader" : root.book-title + " · Sae Reader";
    icon: @image-url("../assets/window-icon.png");
    preferred-width: 1180px; preferred-height: 840px;
    min-width: 640px; min-height: 480px;
    default-font-family: "Microsoft YaHei UI";
    background: ReaderTheme.chrome;
    in-out property <bool> dark <=> ReaderTheme.dark;
    in-out property <color> canvas-color <=> ReaderTheme.paper;
    in property <int> design-variant: 0;
    init => { Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }
    changed dark => { Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }

    in property <[PageTile]> pages;
    in property <int> grid-rows: 1;
    in property <int> visible-count: 1;
    in-out property <bool> pdf-multi: false;
    in property <image> page-image;
    in property <image> right-image;
    in property <string> book-title: "";
    in property <string> status: "";
    in property <string> notice: "";
    in property <int> first-page: 1;
    in property <int> last-page: 1;
    in property <int> page-total: 0;
    in property <bool> has-document: false;
    in property <bool> reflowable: true;
    in property <float> image-width: 0;
    in property <float> image-height: 0;
    in property <float> right-width: 0;
    in property <float> right-height: 0;
    in property <[Mark]> highlights;
    in property <[Mark]> right-highlights;
    in property <[Mark]> search-marks;
    in property <[Mark]> right-search-marks;
    in property <[TocRow]> contents;
    in-out property <string> selected-content-uri;
    in property <[string]> fonts;
    in property <string> family-label: "默认衬线";
    in-out property <int> theme-index: 0;
    in-out property <bool> double-page: false;
    in-out property <bool> show-contents: false;
    in-out property <bool> show-settings: false;
    in-out property <bool> show-search: false;
    in-out property <bool> show-toolbar: false;
    in-out property <bool> top-hover: false;
    in-out property <bool> bottom-hover: false;
    in-out property <bool> zoom-hover: false;
    in-out property <bool> zoom-pinned: false;
    in-out property <bool> zoom-dragging: false;
    in-out property <bool> is-fullscreen: false;
    in-out property <bool> controls-busy: false;
    in-out property <bool> page-entry-active: false;
    out property <bool> top-visible: !root.has-document || root.show-toolbar || root.top-hover || root.show-search || root.show-contents || root.show-settings;
    out property <bool> bottom-visible: root.has-document && (root.page-entry-active || ((root.show-progress || !root.reflowable) && (root.show-toolbar || root.bottom-hover || root.controls-busy || root.zoom-pinned)));
    out property <bool> reading-keys: root.has-document && !root.show-search && !root.show-contents && !root.show-settings && !root.page-entry-active;
    in-out property <bool> show-progress: true;
    in-out property <bool> justified: false;
    in-out property <float> font-size-pt: 18;
    in-out property <float> line-height: 1.55;
    in-out property <float> paragraph-before: 0;
    in-out property <float> paragraph-after: 0.6;
    in-out property <float> indent: 1.5;
    in-out property <float> text-width: 720;
    in-out property <float> margin-top: 28;
    in-out property <float> margin-right: 40;
    in-out property <float> margin-bottom: 28;
    in-out property <float> margin-left: 40;
    out property <float> viewport-width: canvas.width / 1px;
    out property <float> viewport-height: canvas.height / 1px;
    in property <bool> effective-spread: false;
    in property <string> search-status: "";
    in property <float> pdf-zoom: 1;
    in property <float> pdf-fit-width-zoom: 1;
    in property <float> pdf-fill-zoom: 1;
    in property <int> pdf-zoom-stop: 1;
    in property <bool> pdf-pannable: false;
    in property <int> page-color: 0;
    in property <bool> text-document: false;
    in property <string> encoding-label: "";
    in property <string> encoding-choice: "自动检测";
    property <length> window-inset: 16px;
    property <length> header-height: 52px;
    property <length> panel-top: root.header-height + 8px;
    property <length> dock-height: 44px;
    property <length> dock-width: min(root.reflowable ? 440px : root.show-progress || root.page-entry-active ? 528px : 120px,root.width - 2 * root.window-inset);
    out property <length> dock-left: (root.width - root.dock-width) / 2;
    out property <length> dock-right: root.dock-left + root.dock-width;
    out property <length> dock-top: root.height - root.dock-height - 8px;
    property <length> side-panel-height: root.dock-top - root.panel-top - 12px;
    property <length> side-panel-width: 352px;
    out property <length> knob-pop-width: 272px;
    out property <length> knob-pop-height: 120px;
    out property <bool> zoom-can-cover: root.pdf-fill-zoom > root.pdf-fit-width-zoom * 1.035;
    out property <length> knob-pop-left: root.dock-right - root.knob-pop-width;
    out property <length> knob-pop-top: root.dock-top - root.knob-pop-height - 6px;
    out property <length> knob-center-x: root.dock-right - 70px;
    out property <length> knob-center-y: root.knob-pop-top + root.knob-pop-height / 2;
    out property <bool> show-zoom-pop: root.bottom-visible && !root.reflowable && (root.zoom-hover || root.zoom-pinned) && !root.page-entry-active;
    property <length> page-inset: root.reflowable ? 16px : 0px;
    callback open-file(); callback next-page(int); callback back();
    callback typography(string,float); callback resized(); callback follow-link(string);
    callback setting-text(string,string); callback mode-changed(bool); callback theme-changed(int);
    callback multi-mode();
    callback fonts-needed(); callback wheel(float);
    callback select-text(int,float,float,float,float); callback hit(int,float,float); callback copy-text();
    callback search(string); callback search-next(int); callback fullscreen();
    callback pan(float,float); callback encoding-changed(string); callback page-color-changed(int);
    callback wheel-xy(float,float,bool,bool); callback jump-page(string) -> bool;
    callback zoom-begin(); callback zoom-end(); callback refresh-zoom(bool);
    public function edge-hover(x: float, y: float) {
        let px = x * 1px; let py = y * 1px;
        if px < 0px || px >= root.width || py < 0px || py >= root.height {
            root.top-hover = false; root.bottom-hover = false;
            if !root.controls-busy { root.zoom-hover = false; }
            return;
        }
        root.top-hover = py <= (root.top-visible ? root.header-height + 4px : 14px);
        let in-knob = px >= root.dock-right - 112px && px <= root.dock-right && py >= root.dock-top;
        let in-pop = root.show-zoom-pop && px >= root.knob-pop-left && px <= root.dock-right && py >= root.knob-pop-top && py < root.dock-top;
        if !root.controls-busy { root.zoom-hover = !root.reflowable && root.has-document && (in-knob || in-pop); }
        root.bottom-hover = root.zoom-hover || py >= (root.bottom-visible ? root.dock-top - 4px : root.height - 16px);
    }
    function start-zoom() {
        root.focus-reading();
        root.controls-busy = true;
        root.zoom-dragging = true;
        root.zoom-begin();
    }
    function end-zoom() {
        root.zoom-dragging = false;
        root.controls-busy = false;
        root.zoom-end();
    }
    function release-zoom(x: float, y: float) {
        root.end-zoom();
        root.edge-hover(x,y);
    }
    public function focus-reading() { root.page-entry-active = false; keyboard.focus(); }
    public function dismiss-panels() {
        if root.show-search { root.search(""); }
        root.show-contents = false; root.show-settings = false; root.show-search = false;
        root.zoom-pinned = false; root.zoom-hover = false;
        root.focus-reading();
    }
    public function focus-search() {
        if root.has-document {
            root.page-entry-active = false; root.show-settings = false; root.show-contents = false; root.show-search = true;
            root.zoom-pinned = false; query.focus();
        }
    }
    public function focus-page-entry() {
        if root.has-document && root.page-total > 0 {
            root.show-contents = false; root.show-settings = false; root.show-search = false; root.zoom-pinned = false;
            root.page-entry-active = true;
        }
    }
    changed viewport-width => { root.resized(); }
    changed viewport-height => { root.resized(); }
    changed show-settings => { if root.show-settings && root.reflowable { root.fonts-needed(); } }
    forward-focus: keyboard;

    keyboard := FocusScope {
        // Also handle platform-dispatched keys (e.g. accessibility and QA).
        capture-key-pressed(event) => {
            if root.reading-keys && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta {
                if event.text == Key.RightArrow || event.text == Key.PageDown { root.next-page(1); return accept; }
                if event.text == Key.LeftArrow || event.text == Key.PageUp { root.next-page(-1); return accept; }
            }
            return reject;
        }
        key-pressed(event) => {
            if event.modifiers.control && (event.text == "o" || event.text == "O") { root.open-file(); return accept; }
            if event.modifiers.control && (event.text == "f" || event.text == "F") { root.focus-search(); return accept; }
            if event.modifiers.control && (event.text == "c" || event.text == "C") { root.copy-text(); return accept; }
            if root.reading-keys && event.text == " " { root.next-page(1); return accept; }
            if event.text == Key.Escape { root.dismiss-panels(); return accept; }
            if event.text == Key.F11 { root.fullscreen(); return accept; }
            if event.text == Key.F10 { root.show-toolbar = !root.show-toolbar; return accept; }
            if root.reading-keys && event.text == Key.UpArrow { if root.pdf-pannable { root.pan(0,-120); } else { root.next-page(-1); } return accept; }
            if root.reading-keys && event.text == Key.DownArrow { if root.pdf-pannable { root.pan(0,120); } else { root.next-page(1); } return accept; }
            if event.modifiers.control && (event.text == "+" || event.text == "=") { root.typography("delta-size",1); return accept; }
            if event.modifiers.control && event.text == "-" { root.typography("delta-size",-1); return accept; }
            if event.modifiers.control && event.text == "0" { root.typography("size",18); return accept; }
            return reject;
        }

        canvas := Rectangle {
            background: ReaderTheme.paper; clip: true;
            if !root.has-document: VerticalLayout {
                alignment: center; spacing: 16px;
                Text { text: "Sae"; font-family: "Georgia"; font-size: 64px; color: ReaderTheme.ink; horizontal-alignment: center; }
                HorizontalLayout { alignment: center;
                    Rectangle { width: 40px; height: 1px; background: ReaderTheme.line; }
                }
                HorizontalLayout { alignment: center;
                    QuietButton {
                        width: 144px; height: 40px; primary: true; left-aligned: true;
                        text: "打开书籍"; icon: @image-url("../assets/icons/open.svg");
                        clicked => { root.open-file(); }
                    }
                }
                if root.status != "": HorizontalLayout {
                    alignment: center;
                    Text { width: min(root.width - 2 * root.window-inset,420px); wrap: word-wrap; text: root.status; color: ReaderTheme.muted; font-size: 13px; horizontal-alignment: center; }
                }
            }
            if root.has-document: TouchArea {
                clicked => { keyboard.focus(); root.next-page(self.mouse-x < self.width / 2 ? -1 : 1); }
                scroll-event(e) => { root.wheel-xy(e.delta-x / 1px,e.delta-y / 1px,e.modifiers.shift,e.modifiers.control); return accept; }
            }
            for tile[i] in root.pages: PagePane {
                x: i == 1 || i == 3 ? parent.width / 2 + root.page-inset : root.page-inset;
                y: i >= 2 ? parent.height / 2 : 0px;
                width: root.effective-spread ? parent.width / 2 - 2 * root.page-inset : parent.width - 2 * root.page-inset;
                height: root.grid-rows == 2 ? parent.height / 2 : parent.height;
                source: tile.source; page-width: tile.w; page-height: tile.h;
                selection: tile.selection; matches: tile.matches; pannable: root.pdf-pannable;
                turn-mode: root.effective-spread ? (i == 0 || i == 2 ? -1 : 1) : 0;
                join-edge: root.reflowable ? 0 : self.turn-mode;
                select-text(a,b,c,d) => { keyboard.focus(); root.select-text(i,a,b,c,d); }
                hit(a,b) => { keyboard.focus(); root.hit(i,a,b); }
                wheel-xy(x,y,s,c) => { root.wheel-xy(x,y,s,c); }
                pan(x,y) => { root.pan(x,y); }
                navigate(d) => { keyboard.focus(); root.next-page(d); }
            }
            // Created only while a side panel is open. It consumes the complete
            // first gesture, so closing cannot also follow a link or turn a page.
            if root.show-settings || root.show-contents || root.show-search || root.page-entry-active || root.zoom-pinned: TouchArea {
                clicked => {
                    root.show-settings = false; root.show-contents = false; root.show-search = false;
                    root.zoom-pinned = false; root.focus-reading();
                }
            }
        }

        // These panels overlay a stable full-size reading canvas. Hovering does
        // not invoke native pagination, resize the page or allocate new images.
        header := Rectangle {
            x: 0px; y: 0px; width: parent.width; height: root.header-height;
            visible: root.has-document && root.top-visible;
            background: ReaderTheme.chrome;
            Rectangle { x: root.window-inset; y: 1px; width: parent.width - 2 * self.x; height: 1px; background: ReaderTheme.edge; }
            Rectangle { y: parent.height - 1px; height: 1px; background: ReaderTheme.line; }
            Rectangle { y: parent.height; height: 2px; background: ReaderTheme.contact; }
            TouchArea {}
            HorizontalLayout {
                padding-left: root.window-inset; padding-right: root.window-inset; padding-top: 10px; padding-bottom: 10px; spacing: 8px;
                QuietButton { icon: @image-url("../assets/icons/open.svg"); label: "打开书籍"; clicked => { root.open-file(); } }
                Rectangle { width: 1px; height: 16px; background: ReaderTheme.line; }
                Text { text: root.book-title; font-size: 15px; font-weight: 600; color: ReaderTheme.ink; horizontal-stretch: 1; min-width: 0px; overflow: elide; vertical-alignment: center; }
                if root.has-document && root.width > 780px: QuietButton { text: "返回"; clicked => { root.back(); root.focus-reading(); } }
                if root.has-document: QuietButton { icon: @image-url("../assets/icons/contents.svg"); label: "目录"; selected: root.show-contents; clicked => { root.show-contents = !root.show-contents; root.show-settings = false; root.show-search = false; root.focus-reading(); } }
                if root.has-document: QuietButton { icon: @image-url("../assets/icons/search.svg"); label: "全文查找"; selected: root.show-search; clicked => { if root.show-search { root.dismiss-panels(); } else { root.focus-search(); } } }
                if root.has-document: Rectangle { width: 1px; height: 16px; background: ReaderTheme.line; }
                if root.has-document: Rectangle {
                    width: root.reflowable ? 100px : 148px; height: 32px; border-radius: ReaderTheme.radius; background: ReaderTheme.well;
                    Rectangle { x: 4px; y: 1px; width: parent.width - 8px; height: 1px; background: ReaderTheme.line; }
                    HorizontalLayout { padding-left: 2px; padding-right: 2px; spacing: 0px;
                        QuietButton { width: 48px; text: "单页"; compact-selection: true; selected: !root.double-page && (root.reflowable || !root.pdf-multi); clicked => { root.pdf-multi = false; root.double-page = false; root.mode-changed(false); keyboard.focus(); } }
                        QuietButton { width: 48px; text: "双页"; compact-selection: true; selected: root.double-page && (root.reflowable || !root.pdf-multi); clicked => { root.pdf-multi = false; root.double-page = true; root.mode-changed(true); keyboard.focus(); } }
                        if !root.reflowable: QuietButton { width: 48px; text: "多页"; compact-selection: true; selected: root.pdf-multi; clicked => { root.pdf-multi = true; root.multi-mode(); keyboard.focus(); } }
                    }
                }
                QuietButton { icon: @image-url("../assets/icons/settings.svg"); label: "阅读设置"; selected: root.show-settings; clicked => { root.show-settings = !root.show-settings; root.show-contents = false; root.show-search = false; root.focus-reading(); } }
                QuietButton { icon: @image-url("../assets/icons/fullscreen.svg"); label: root.is-fullscreen ? "退出全屏" : "全屏"; selected: root.is-fullscreen; clicked => { root.fullscreen(); } }
            }
        }
        searchbar := RaisedPanel {
            visible: root.show-search;
            x: parent.width - self.width - root.window-inset; y: root.panel-top;
            width: min(520px,parent.width - 2 * root.window-inset); height: root.search-status == "" ? 56px : 88px;
            VerticalLayout {
                padding: 12px; spacing: 8px;
                HorizontalLayout {
                    spacing: 4px;
                    query := LineEdit { height: 32px; placeholder-text: "搜索全文"; accepted => { root.search(self.text); } }
                    QuietButton { text: "查找"; clicked => { root.search(query.text); } }
                    QuietButton { text: "上处"; clicked => { root.search-next(-1); } }
                    QuietButton { text: "下处"; clicked => { root.search-next(1); } }
                    QuietButton { icon: @image-url("../assets/icons/close.svg"); label: "关闭查找"; clicked => { root.dismiss-panels(); } }
                }
                if root.search-status != "": Text {
                    height: 24px; text: root.search-status; color: ReaderTheme.muted; font-size: 12px; overflow: elide;
                    vertical-alignment: center;
                }
            }
        }
        if root.show-contents: RaisedPanel {
            x: root.window-inset; y: root.panel-top; width: min(root.side-panel-width,parent.width - 2 * root.window-inset);
            height: root.contents.length == 0 ? 112px : root.side-panel-height;
            PanelHeading { width: parent.width; title: "目录"; icon: @image-url("../assets/icons/contents.svg"); closed => { root.dismiss-panels(); } }
            if root.contents.length == 0: Text {
                x: ReaderTheme.pad; y: 52px; height: 56px;
                text: "这份文档没有目录"; font-size: 13px; color: ReaderTheme.muted; vertical-alignment: center;
            }
            if root.contents.length > 0: ListView {
                    x: 8px; y: 60px; width: parent.width - 16px; height: parent.height - 68px;
                    horizontal-scrollbar-policy: always-off;
                    content-width: self.visible-width;
                    for row in root.contents: Rectangle {
                    // ListView instantiates visible rows only. A growing title
                    // gets its real height and never shares the scrollbar lane.
                    width: parent.width - 16px; height: max(row.depth == 0 ? 44px : 36px,toc-title.preferred-height + 16px); border-radius: ReaderTheme.radius;
                    background: row.uri == root.selected-content-uri || toc-touch.has-hover || toc-focus.has-focus ? ReaderTheme.tint : transparent;
                    accessible-role: button; accessible-label: row.title;
                    accessible-action-default => { root.follow-link(row.uri); root.show-contents = false; keyboard.focus(); }
                    forward-focus: toc-focus;
                    if row.depth > 0: Rectangle {
                        x: 12px + (min(row.depth,5) - 1) * 12px;
                        y: 0px; width: 1px; height: parent.height; background: ReaderTheme.line;
                    }
                    if row.uri == root.selected-content-uri || toc-focus.has-focus: Rectangle { x: 4px; y: 8px; width: 2px; height: parent.height - 16px; border-radius: 1px; background: ReaderTheme.accent; }
                    toc-title := Text {
                        x: 16px + min(row.depth,5) * 12px; y: (parent.height - self.height) / 2;
                        width: parent.width - self.x - 8px; height: self.preferred-height;
                        text: row.title; wrap: word-wrap; vertical-alignment: top;
                        font-family: row.latin && row.depth == 0 ? "Georgia" : row.latin ? "Segoe UI" : "Microsoft YaHei UI";
                        font-size: 14px; font-weight: row.uri == root.selected-content-uri ? 600 : 400;
                        color: row.uri == root.selected-content-uri ? ReaderTheme.accent : row.depth == 0 ? ReaderTheme.ink : ReaderTheme.muted;
                    }
                    toc-focus := FocusScope { key-pressed(e) => { if e.text == Key.Return || e.text == " " { root.follow-link(row.uri); root.show-contents = false; keyboard.focus(); return accept; } return reject; } }
                    toc-touch := TouchArea { mouse-cursor: pointer; clicked => { root.follow-link(row.uri); root.show-contents = false; keyboard.focus(); } }
                }
            }
        }
        if root.show-settings: RaisedPanel {
            x: parent.width - self.width - root.window-inset; y: root.panel-top;
            width: min(root.side-panel-width,parent.width - 2 * root.window-inset);
            height: min(root.side-panel-height,53px + settings-form.preferred-height);
            PanelHeading {
                width: parent.width;
                title: root.reflowable ? "阅读排版" : "页面设置";
                icon: @image-url("../assets/icons/settings.svg"); closed => { root.dismiss-panels(); }
            }
            settings-scroll := ScrollView {
                x: 1px; y: 52px; width: parent.width - 2px; height: parent.height - 53px;
                horizontal-scrollbar-policy: always-off;
                content-width: self.width;
                content-height: settings-form.preferred-height;
                settings-form := VerticalLayout {
                    width: settings-scroll.width; height: self.preferred-height;
                    padding-left: ReaderTheme.pad; padding-right: ReaderTheme.pad; padding-top: 12px; padding-bottom: ReaderTheme.pad;
                    spacing: 20px;
                    VerticalLayout {
                        spacing: 4px;
                        GroupLabel { text: "主题"; }
                        HorizontalLayout {
                            height: 32px; spacing: 4px;
                            QuietButton { text: "暖纸"; swatch: #f8f6f1; selected: root.theme-index==0; clicked => { root.theme-changed(0); } }
                            QuietButton { text: "白纸"; swatch: #ffffff; selected: root.theme-index==1; clicked => { root.theme-changed(1); } }
                            QuietButton { text: "夜读"; swatch: #171a19; selected: root.theme-index==2; clicked => { root.theme-changed(2); } }
                        }
                    }
                    if !root.reflowable: VerticalLayout {
                        spacing: 4px;
                        GroupLabel { text: "页面颜色"; }
                        Rectangle {
                            height: 36px; border-radius: ReaderTheme.radius; background: ReaderTheme.well;
                            HorizontalLayout {
                                padding: 2px; spacing: 4px;
                                QuietButton { text: "原色"; selected: root.page-color==0; clicked => { root.page-color-changed(0); } }
                                QuietButton { text: "随主题"; selected: root.page-color==1; clicked => { root.page-color-changed(1); } }
                                QuietButton { text: "反色"; selected: root.page-color==2; clicked => { root.page-color-changed(2); } }
                            }
                        }
                    }
                    if root.reflowable: VerticalLayout {
                        spacing: 4px;
                        GroupLabel { text: "文字"; }
                        ComboBox { height: 32px; model: root.fonts; current-value: root.family-label; selected(value) => { root.setting-text("family",value); } }
                        SettingField { label: "字号"; unit: "pt"; minimum:12; maximum:36; value <=> root.font-size-pt; edited(v)=>{root.typography("size",v);} entered(s)=>{root.setting-text("size",s);} }
                        SettingField { label: "行距"; unit: "倍"; minimum:1.15; maximum:2.2; value <=> root.line-height; edited(v)=>{root.typography("line",v);} entered(s)=>{root.setting-text("line",s);} }
                    }
                    if root.reflowable: VerticalLayout {
                        spacing: 4px;
                        GroupLabel { text: "段落"; }
                        SettingField { label: "段前"; unit: "em"; minimum:0; maximum:2; value <=> root.paragraph-before; edited(v)=>{root.typography("before",v);} entered(s)=>{root.setting-text("before",s);} }
                        SettingField { label: "段后"; unit: "em"; minimum:0; maximum:2; value <=> root.paragraph-after; edited(v)=>{root.typography("paragraph",v);} entered(s)=>{root.setting-text("paragraph",s);} }
                        SettingField { label: "首行缩进"; unit: "em"; minimum:0; maximum:2.5; value <=> root.indent; edited(v)=>{root.typography("indent",v);} entered(s)=>{root.setting-text("indent",s);} }
                        PanelToggle { text: "两端对齐"; checked <=> root.justified; toggled => {root.typography("justify",self.checked?1:0);} }
                    }
                    if root.reflowable: VerticalLayout {
                        spacing: 4px;
                        GroupLabel { text: "页面"; }
                        SettingField { label: "正文宽度"; unit: "px"; minimum:260; maximum:1200; value <=> root.text-width; edited(v)=>{root.typography("width",v);} entered(s)=>{root.setting-text("width",s);} }
                        SettingField { label: "上边距"; unit: "pt"; minimum:0; maximum:100; value <=> root.margin-top; edited(v)=>{root.typography("top",v);} entered(s)=>{root.setting-text("top",s);} }
                        SettingField { label: "下边距"; unit: "pt"; minimum:0; maximum:100; value <=> root.margin-bottom; edited(v)=>{root.typography("bottom",v);} entered(s)=>{root.setting-text("bottom",s);} }
                        SettingField { label: "左边距"; unit: "pt"; minimum:0; maximum:100; value <=> root.margin-left; edited(v)=>{root.typography("left",v);} entered(s)=>{root.setting-text("left",s);} }
                        SettingField { label: "右边距"; unit: "pt"; minimum:0; maximum:100; value <=> root.margin-right; edited(v)=>{root.typography("right",v);} entered(s)=>{root.setting-text("right",s);} }
                    }
                    if root.text-document: VerticalLayout {
                        spacing: 4px;
                        GroupLabel { text: "文本编码"; }
                        ComboBox { height: 32px; current-value: root.encoding-choice; model: ["自动检测","UTF-8","UTF-16LE","UTF-16BE","GB18030","Big5","Shift_JIS","windows-1252"]; selected(v) => { root.encoding-changed(v); } }
                        Text { text: root.encoding-label; color: ReaderTheme.muted; font-size: 12px; }
                    }
                    if root.notice != "": VerticalLayout {
                        spacing: 4px;
                        GroupLabel { text: "文档信息"; }
                        Text {
                            text: root.notice; wrap: word-wrap;
                            color: ReaderTheme.muted; font-size: 12px;
                        }
                    }
                    HorizontalLayout {
                        height: 32px; spacing: 8px;
                        PanelToggle { text: "阅读进度"; horizontal-stretch: 0; checked <=> root.show-progress; toggled=>{root.typography("progress",self.checked?1:0);} }
                        Rectangle { horizontal-stretch: 1; }
                        if root.reflowable: QuietButton { text: "恢复默认"; clicked=>{root.typography("reset",0);} }
                    }
                }
            }
        }

        if root.show-zoom-pop: RaisedPanel {
            // A recessed plane frames the dial. The rail and the enlarged
            // dial share a right edge and a single hover region (§6.4).
            x: root.knob-pop-left; y: root.knob-pop-top;
            width: root.knob-pop-width; height: root.knob-pop-height;
            Path {
                x: 140px; y: 10px; width: 122px; height: 100px;
                viewbox-width: 122; viewbox-height: 100;
                commands: "M8 0H122V92L114 100H0V8Z";
                fill: ReaderTheme.well;
            }
            Rectangle { x: 148px; y: 10px; width: 114px; height: 1px; background: ReaderTheme.line; }
            ZoomKnob {
                x: root.knob-center-x - root.knob-pop-left - self.width / 2;
                y: 0px; width: 112px; height: parent.height;
                large: true; value: root.pdf-zoom; dragging: root.zoom-dragging;
                stepped(d) => { root.typography("zoom",pow(1.12,d)); }
                started => { root.start-zoom(); }
                travelled(d) => { root.typography("zoom-drag",d); }
                released(x,y) => { root.release-zoom(x,y); }
                cancelled => { root.end-zoom(); }
            }
            VerticalLayout {
                x: 12px; y: 0px; width: 116px; height: root.knob-pop-height;
                alignment: center; spacing: 4px;
                QuietButton {
                    width: 116px; height: 32px; left-aligned: true;
                    text: "100%"; label: "100%，显示整页"; selected: root.pdf-zoom-stop==1; compact-selection: true;
                    clicked => { root.typography("fit-page",0); root.focus-reading(); }
                }
                QuietButton {
                    width: 116px; height: 32px; left-aligned: true;
                    text: "适宽"; selected: root.pdf-zoom-stop==3 || (!root.zoom-can-cover && root.pdf-zoom-stop==2); compact-selection: true;
                    clicked => { root.typography("fit-width",0); root.focus-reading(); }
                }
                if root.zoom-can-cover: QuietButton {
                    width: 116px; height: 32px; left-aligned: true;
                    text: "铺满"; label: "铺满视区"; selected: root.pdf-zoom-stop==2; compact-selection: true;
                    clicked => { root.typography("fit-cover",0); root.focus-reading(); }
                }
            }
        }
        if root.bottom-visible: RaisedPanel {
            x: root.dock-left; y: root.dock-top; width: root.dock-width; height: root.dock-height;
            HorizontalLayout {
                padding-left: 16px; padding-right: 12px; spacing: 12px;
                if root.show-progress || root.page-entry-active: PageScrubber {
                    first: root.first-page; last: root.last-page; total: root.page-total; editing: root.page-entry-active; horizontal-stretch: 1;
                    edit => { root.focus-page-entry(); }
                    jump(v) => { let ok = root.jump-page(v); if ok { root.focus-reading(); } return ok; }
                    turned(d) => { root.next-page(d); }
                    active(v) => { root.controls-busy = v; }
                }
                if !root.reflowable && (root.show-progress || root.page-entry-active): Rectangle { width: 1px; height: 16px; background: ReaderTheme.line; }
                if !root.reflowable: ZoomKnob {
                    width: 88px; height: 36px; value: root.pdf-zoom; dragging: root.zoom-dragging;
                    border-radius: ReaderTheme.radius;
                    background: root.show-zoom-pop ? ReaderTheme.well : transparent;
                    stepped(d) => { root.typography("zoom",pow(1.12,d)); }
                    started => { root.start-zoom(); }
                    travelled(d) => { root.typography("zoom-drag",d); }
                    released(x,y) => { root.release-zoom(x,y); }
                    cancelled => { root.end-zoom(); }
                    opened => { root.zoom-pinned = !root.zoom-pinned; }
                }
            }
        }
        if root.has-document && root.status != "": RaisedPanel {
            x: (parent.width - self.width) / 2; y: root.panel-top;
            width: min(parent.width - 2 * root.window-inset,520px); height: message.preferred-height + 24px;
            message := Text {
                x: 16px; y: 12px; width: parent.width - 32px;
                text: root.status; wrap: word-wrap;
                color: ReaderTheme.ink; font-size: 13px;
            }
        }
    }
}
