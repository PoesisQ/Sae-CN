// One printed field, one title, one open action (§2.1, §6.1, §8.4).
// The two controls use the same printed scale and a fixed reading index.
import { LineEdit, ScrollView, ListView, Palette } from "std-widgets.slint";
import { DockOutline } from "dock.slint";
import { SmoothSurface } from "surface.slint";

export struct Mark { x:float, y:float, w:float, h:float }
export struct PageTile { source:image, w:float, h:float, selection:[Mark], matches:[Mark] }
export struct CoverRect { x: float, y: float, w: float, h: float, window-w: float, window-h: float }
export struct PageScene { paper: color, viewport-w: float, viewport-h: float, columns: int, rows: int, flow: bool, fit: bool, inset: float }
export struct GlassView { center: float, radius: float, rail: float, density: float, chrome: color, dark: bool, scene: PageScene }
export enum FrostKind { rail, dock, panel, menu, notice }
export struct FrostMap { picture: image, w: float, h: float, dark: bool }
export struct FrostRect { x: float, y: float, w: float, h: float, corner: float, rise: float }
export global Materials {
    pure callback face(FrostMap, FrostRect, FrostKind) -> image;
    pure callback dock-edge(FrostMap, float, float) -> color;
    pure callback zoom-lens(FrostMap, float, float, float, float) -> image;
}
export struct TocRow { title:string, uri:string, depth:int, latin:bool }

export global ReaderTheme {
    in-out property <bool> dark: false;
    in-out property <color> paper: #f8f6f1;
    out property <color> chrome: dark ? #232927 : #efefe9;
    out property <color> ink: dark ? #e9ece9 : #262c29;
    out property <color> muted: dark ? #becbc5 : #46564f;
    out property <color> line: dark ? #48534c : #d7dbd3;
    out property <color> accent: dark ? #a9c5b7 : #46675c;
    out property <color> tint: dark ? #a9c5b71f : #46675c18;
    out property <color> surface: dark ? #2c3430 : #fbfaf6;
    out property <color> well: dark ? #1c2320 : #ebede6;
    out property <color> edge: dark ? #58645e : #fffffc;
    out property <color> contact: dark ? #0a141a62 : #23393828;
    out property <color> penumbra: dark ? #0b12152e : #2d454314;
    out property <color> seam: dark ? #718582 : #d0dbd5;
    out property <color> bevel: dark ? #a7bbb270 : #fffffbb5;
    out property <color> invalid: dark ? #f0ae9a : #9a4238;
    out property <length> pad: 16px;
    out property <length> button-height: 32px;
    out property <length> radius: 8px;
    out property <length> shoulder: 16px;
    out property <length> contact-depth: 2px;
}

component QuietButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <string> label: root.text;
    in property <color> swatch: transparent;
    in property <bool> selected: false;
    in property <bool> compact-selection: false;
    in property <bool> left-aligned: false;
    in property <bool> enabled: true;
    callback clicked();
    height: ReaderTheme.button-height; min-width: 32px;
    preferred-width: root.text == "" ? 36px : caption.preferred-width + 24px + (root.icon.width > 0 || root.swatch.alpha > 0 ? 24px : 0px);
    horizontal-stretch: 0;
    border-radius: ReaderTheme.radius;
    background: touch.pressed ? ReaderTheme.well : root.selected || touch.has-hover ? ReaderTheme.tint : transparent;
    border-width: focus.has-focus ? 1px : 0px;
    border-color: focus.has-focus ? ReaderTheme.accent : ReaderTheme.line;
    opacity: root.enabled ? 1 : 0.4;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    caption := Text {
        visible: root.text != "";
        text: root.text;
        x: root.icon.width > 0 ? 36px : root.swatch.alpha > 0 ? 24px : root.left-aligned ? 16px : 0px;
        width: max(0px,parent.width - self.x - (root.left-aligned ? 8px : 0px));
        color: root.selected ? ReaderTheme.accent : ReaderTheme.ink;
        font-size: 13px; font-weight: root.selected ? 600 : 400;
        min-width: 0px; overflow: elide;
        horizontal-alignment: root.left-aligned ? left : center; vertical-alignment: center;
    }
    if root.swatch.alpha > 0: Rectangle {
        x: 10px; y: (parent.height - self.height) / 2; width: 12px; height: 16px;
        border-radius: 2px; border-width: 1px; border-color: ReaderTheme.line; background: root.swatch;
    }
    if root.icon.width > 0: Image {
        x: root.text == "" ? (parent.width - 18px) / 2 : 12px; y: (parent.height - 18px) / 2;
        width: 18px; height: 18px; source: root.icon;
        colorize: root.selected ? ReaderTheme.accent : ReaderTheme.muted;
    }
    if root.compact-selection && root.selected: Rectangle {
        x: 4px; y: (parent.height - self.height) / 2; width: 2px; height: 12px;
        background: ReaderTheme.accent;
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                if root.enabled { root.clicked(); } return accept;
            }
            return reject;
        }
    }
    touch := TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.clicked(); } }
}

// The rails transmit more of a page than a sheet of settings. Menus sit a step
// above their sheet. The narrow rim carries focus without a full-window shadow.
component FrostFace inherits Image {
    in property <FrostMap> material;
    in property <FrostKind> kind: FrostKind.panel;
    in property <length> corner: ReaderTheme.shoulder;
    in property <length> rise: 0px;
    in property <length> sample-x: root.absolute-position.x;
    in property <length> sample-y: root.absolute-position.y;
    image-fit: fill; image-rendering: smooth;
    source: Materials.face(root.material,{x:root.sample-x/1px,y:root.sample-y/1px,w:self.width/1px,h:self.height/1px,
        corner:root.corner/1px,rise:root.rise/1px},root.kind);
}

component RaisedPanel inherits Rectangle {
    in property <length> corner: ReaderTheme.shoulder;
    in property <FrostMap> material;
    in property <FrostKind> kind: FrostKind.panel;
    in property <length> sample-x: root.absolute-position.x;
    in property <length> sample-y: root.absolute-position.y;
    SmoothSurface { x: -1px; y: 3px; width: parent.width + 2px; height: parent.height + 1px; corner: root.corner + 1px; tone: ReaderTheme.penumbra; }
    SmoothSurface { y: ReaderTheme.contact-depth; width: parent.width; height: parent.height; corner: root.corner; tone: ReaderTheme.contact; }
    SmoothSurface { width: parent.width; height: parent.height; corner: root.corner; tone: ReaderTheme.seam; }
    SmoothSurface {
        x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
        corner: root.corner - 1px; tone: ReaderTheme.surface;
    }
    if root.visible && root.material.picture.width > 0: FrostFace {
        width: parent.width; height: parent.height; material: root.material; kind: root.kind; corner: root.corner;
        sample-x:root.sample-x; sample-y:root.sample-y;
    }
    Rectangle { x: root.corner; y: 1px; width: max(0px,parent.width - 2*self.x); height: 1px;
        background: @linear-gradient(90deg, transparent, ReaderTheme.bevel 28%, transparent); }
    TouchArea {}
    @children
}

component Frontispiece inherits Rectangle {
    in property <string> message;
    in property <bool> book-drag-over;
    in property <int> variant;
    in property <image> frame;
    in property <bool> departing;
    in property <image> dissolve;
    in property <float> progress;
    property <float> lettering-opacity: max(0, 1 - 2.4*root.progress);
    pure callback tone(image, float, float, float, float) -> int;
    pure callback negative(image, CoverRect, bool) -> image;
    callback open();
    property <length> inset: clamp(min(root.width,root.height)/16,24px,64px);
    property <length> margin: root.variant == 0 ? clamp(root.width * 0.066,28px,108px) : root.inset;
    property <color> ink: #23302c;
    property <length> type-size: min(root.width * 0.179, root.height * 0.242);
    background: root.departing ? transparent : #f3efe4;
    clip: true;
    property <length> print-width: max(root.width,root.height*1.6);
    property <length> print-height: root.print-width/1.6;
    property <length> print-x: (root.width - root.print-width)*0.16;
    property <length> print-y: (root.height - root.print-height)*0.48;
    // The mark reads physical texels from the film. Snap all four dimensions so
    // fractional DPI never stretches a row of grain a second time inside the type.
    property <length> logo-w: round(min(root.width*0.30,root.height*0.40,356px)/1phx)*1phx;
    property <length> logo-h: round(root.logo-w*753/1395/1phx)*1phx;
    property <length> logo-x: round((root.inset - root.logo-w*0.032)/1phx)*1phx;
    property <length> logo-y: round((action.y - root.inset*0.32 - root.logo-h)/1phx)*1phx;
    property <bool> pale-type: true;
    if root.variant == 0: Image {
        x: root.print-x; y: root.print-y; width: root.print-width; height: root.print-height;
        image-fit: fill; image-rendering: smooth;
        source: root.frame.width > 0 ? root.frame : @image-url("../assets/frontispiece.svg");
    }
    if root.variant != 0: film := Rectangle {
        width: root.width; height: root.height;
        property <image> picture: root.frame;
        Image { width: parent.width; height: parent.height; image-fit: fill; source: root.departing ? root.dissolve : film.picture; }
        property <int> exposure: root.tone(self.picture,root.logo-x/root.width,root.logo-y/root.height,root.logo-w/root.width,root.logo-h/root.height);
        init => { root.pale-type = self.exposure < 136; }
        changed exposure => {
            if self.exposure < 116 { root.pale-type = true; }
            else if self.exposure > 149 { root.pale-type = false; }
        }
        Image {
            x: root.logo-x; y: root.logo-y; width: root.logo-w; height: root.logo-h; image-fit: fill;
            accessible-role: text; accessible-label: "Sae";
            opacity: root.lettering-opacity;
            source: root.negative(film.picture,{x:self.x/1phx, y:self.y/1phx, w:self.width/1phx,
                h:self.height/1phx, window-w:root.width/1phx, window-h:root.height/1phx},root.variant == 2);
        }
    }
    if root.variant == 0: Text {
        opacity: root.lettering-opacity;
        x: root.margin; y: root.height*0.558;
        text: "READER";
        font-family: "Segoe UI"; font-size: 12px; font-weight: 600; letter-spacing: 3px; color: root.ink;
    }
    if root.variant == 0: Text {
        opacity: root.lettering-opacity;
        x: root.margin - self.font-size * 0.054; y: root.height * 0.574;
        width: root.width * 0.47; height: self.font-size * 1.18;
        text: "Sae"; font-family: "Georgia"; font-weight: 400;
        font-size: root.type-size; letter-spacing: -0.065 * self.font-size;
        vertical-alignment: center; color: root.ink;
    }
    action := Rectangle {
        opacity: root.lettering-opacity;
        x: root.margin; y: root.variant == 0 ? parent.height*0.895 - self.height/2 : parent.height - root.inset - self.height;
        width: root.variant == 0 ? 126px : 116px; height: root.variant == 0 ? 44px : 38px;
        property <string> label: root.book-drag-over ? "松开打开" : "选择书籍";
        accessible-role: button; accessible-label: self.label; forward-focus: focus;
        accessible-action-default => { root.open(); }
        property <bool> film: root.variant != 0;
        property <bool> pale: !touch.pressed && (root.pale-type != (touch.has-hover || focus.has-focus));
        property <color> action-ink: film ? (pale ? #172328 : #fffaf0) : touch.has-hover || focus.has-focus ? #a33620 : root.ink;
        if action.film: Rectangle {
            border-radius: self.height/2;
            background: action.pale ? #f8f5ea : #172328;
        }
        Text { x: action.film ? 15px : 0px; width: 72px; height: parent.height; horizontal-alignment: left; text: action.label;
            font-size: action.film ? 14px : 15px; font-weight: 600; color: action.action-ink; vertical-alignment: center; }
        Path { x: action.film ? 86px : 80px; y: (parent.height - 16px)/2; width: 16px; height: 16px; viewbox-width: 16; viewbox-height: 16;
            commands: "M3.5 12.5L12 4 M4.5 4H12V11.5"; stroke: action.action-ink; stroke-width: 1.5px; }
        if focus.has-focus: Rectangle { x: action.film ? 15px : 0px; y: action.film ? parent.height - 7px : parent.height - 4px; width: action.film ? 56px : 94px; height: 1px; background: action.action-ink; }
        focus := FocusScope { key-pressed(e) => { if e.text == Key.Return || e.text == " " { root.open(); return accept; } return reject; } }
        touch := TouchArea { mouse-cursor: pointer; clicked => { root.open(); } }
    }
    if root.message != "": RaisedPanel {
        kind: FrostKind.notice; corner: 10px;
        material: {picture:root.variant!=0 && root.frame.width>0 ? root.frame : root.variant==2 ? @image-url("../assets/home/blue-still.png") : @image-url("../assets/home/plasma-still.png"),
                   w:root.width/1px,h:root.height/1px,dark:false};
        x: root.margin; y: root.variant == 0 ? action.y - self.height - 8px : root.inset;
        width: min(error.preferred-width + 24px,root.width - root.margin*2,460px); height: error.preferred-height + 14px;
        error := Text { x: 12px; y: 7px; width: parent.width - 24px; text: root.message; wrap: word-wrap; color: root.ink; font-size: 13px; }
    }
}

component PanelHeading inherits Rectangle {
    in property <string> title;
    in property <image> icon;
    callback closed();
    x: 0px; y: 0px; height: 52px;
    Rectangle { x: ReaderTheme.pad; y: parent.height - 1px; width: parent.width - 2 * self.x; height: 1px; background: ReaderTheme.line; }
    Image { x: ReaderTheme.pad; y: 18px; width: 16px; height: 16px; source: root.icon; colorize: ReaderTheme.muted; }
    Text {
        x: 40px; y: 0px; width: parent.width - 88px; height: parent.height;
        text: root.title; font-size: 16px; font-weight: 600; color: ReaderTheme.ink;
        vertical-alignment: center; overflow: elide;
    }
    QuietButton { x: parent.width - 44px; y: 10px; width: 32px; icon: @image-url("../assets/icons/close.svg"); label: "收起"; clicked => { root.closed(); } }
}

component GroupLabel inherits Text {
    color: ReaderTheme.muted;
    font-size: 12px;
    font-weight: 600;
    height: 20px;
    vertical-alignment: center;
}

component ChoiceField inherits Rectangle {
    in property <FrostMap> material;
    in property <[string]> model;
    in property <string> value;
    in property <string> label;
    in property <length> window-height;
    out property <bool> is-open: menu.is-open;
    callback expanded(bool);
    callback selected(string);
    callback current-index([string],string) -> int;
    property <int> cursor;
    property <int> visible-rows: min(6,root.model.length);
    height: 32px; border-radius: ReaderTheme.radius;
    background: button-touch.has-hover ? ReaderTheme.tint : ReaderTheme.well;
    border-width: button-focus.has-focus ? 1px : 0px; border-color: ReaderTheme.accent;
    accessible-role: combobox; accessible-label: label; accessible-value: value;
    accessible-expandable: true; accessible-expanded: is-open;
    accessible-action-expand => { root.show-menu(); }
    forward-focus: button-focus;
    changed is-open => { root.expanded(root.is-open); }
    function show-menu() {
        if root.model.length > 0 {
            root.cursor = max(0,root.current-index(root.model,root.value));
            button-focus.focus(); menu.show();
        }
    }
    function choose(index: int) {
        if index >= 0 && index < root.model.length { root.selected(root.model[index]); }
    }
    Text { x: 12px; y: 0px; width: parent.width - 44px; height: parent.height; text: root.value; color: ReaderTheme.ink; font-size: 13px; vertical-alignment: center; overflow: elide; }
    Path {
        x: parent.width - 24px; y: (parent.height - 12px) / 2; width: 12px; height: 12px;
        viewbox-width: 12; viewbox-height: 12; commands: "M1 4L6 9 11 4"; stroke: ReaderTheme.muted; stroke-width: 1.3px;
    }
    button-focus := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Return || e.text == " " { root.show-menu(); return accept; }
            if e.text == Key.DownArrow || e.text == Key.UpArrow {
                root.choose(clamp(root.current-index(root.model,root.value) + (e.text == Key.DownArrow ? 1 : -1),0,root.model.length - 1)); return accept;
            }
            return reject;
        }
    }
    button-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.show-menu(); }
        scroll-event(e) => {
            if !button-focus.has-focus || abs(e.delta-y) < 2px { return reject; }
            root.choose(clamp(root.current-index(root.model,root.value) + (e.delta-y < 0px ? 1 : -1),0,root.model.length - 1));
            return accept;
        }
    }
    menu := PopupWindow {
        x: 0px;
        y: root.absolute-position.y + root.height + self.height + 4px <= root.window-height ? root.height + 4px : -self.height - 4px;
        width: root.width; height: root.visible-rows * 32px + 16px;
        close-policy: close-on-click-outside; forward-focus: menu-focus;
        menu-focus := FocusScope {
            function reveal() {
                let top = root.cursor * 32px;
                list.content-y = clamp(list.content-y, -top, -top + list.height - 32px);
            }
            init => { self.reveal(); }
            key-pressed(e) => {
                if e.text == Key.Escape { menu.close(); return accept; }
                if e.text == Key.Return || e.text == " " { root.choose(root.cursor); menu.close(); return accept; }
                if e.text == Key.UpArrow || e.text == Key.DownArrow || e.text == Key.Home || e.text == Key.End {
                    root.cursor = e.text == Key.Home ? 0 : e.text == Key.End ? root.model.length - 1
                        : clamp(root.cursor + (e.text == Key.DownArrow ? 1 : -1),0,root.model.length - 1);
                    self.reveal(); return accept;
                }
                return reject;
            }
            RaisedPanel {
                material: root.material; kind: FrostKind.menu; corner: 12px;
                sample-x: root.absolute-position.x; sample-y: root.absolute-position.y + menu.y;
                list := ListView {
                    x: 8px; y: 8px; width: parent.width - 16px; height: parent.height - 16px;
                    horizontal-scrollbar-policy: always-off; content-width: self.visible-width;
                    for name[index] in root.model: Rectangle {
                        height: 32px; width: parent.width - 12px; border-radius: ReaderTheme.radius;
                        background: item-touch.has-hover || root.cursor == index ? ReaderTheme.tint : transparent;
                        accessible-role: list-item; accessible-label: name;
                        accessible-action-default => { root.choose(index); menu.close(); }
                        if name == root.value: Rectangle { x: 4px; y: 10px; width: 2px; height: 12px; background: ReaderTheme.accent; }
                        Text { x: 12px; y: 0px; height: parent.height; width: parent.width - 20px; text: name; color: ReaderTheme.ink; font-size: 13px; vertical-alignment: center; overflow: elide; }
                        item-touch := TouchArea { mouse-cursor: pointer; clicked => { root.choose(index); menu.close(); } }
                    }
                }
            }
        }
    }
}

component PanelToggle inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled();
    function flip() { root.checked = !root.checked; root.toggled(); }
    height: 32px; min-width: caption.preferred-width + 54px;
    border-radius: ReaderTheme.radius;
    border-width: focus.has-focus ? 1px : 0px;
    border-color: ReaderTheme.accent;
    background: touch.has-hover ? ReaderTheme.tint : transparent;
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.flip(); }
    forward-focus: focus;
    Rectangle {
        x: 4px; y: 7px; width: 32px; height: 18px; border-radius: 9px;
        background: root.checked ? ReaderTheme.accent : ReaderTheme.well;
        border-width: 1px; border-color: root.checked ? ReaderTheme.accent : ReaderTheme.line;
        Rectangle {
            x: root.checked ? 17px : 3px; y: 3px; width: 12px; height: 12px;
            border-radius: 6px; background: root.checked ? ReaderTheme.surface : ReaderTheme.muted;
        }
    }
    caption := Text {
        x: 44px; y: 0px; height: parent.height; text: root.text;
        color: ReaderTheme.ink; font-size: 13px; vertical-alignment: center;
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.flip(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.flip(); } }
}

component SettingField inherits Rectangle {
    in property <string> label;
    in property <string> unit;
    in property <float> minimum;
    in property <float> maximum;
    in property <float> step: root.unit == "px" ? 4 : root.unit == "pt" ? 1 : 0.05;
    in-out property <float> value;
    in property <bool> enabled: true;
    callback edited(float);
    callback entered(string);
    height: 40px;
    opacity: root.enabled ? 1 : 0.45;
    function set-value(value: float) {
        let next = clamp(value,root.minimum,root.maximum);
        if next != root.value { root.value = next; root.edited(next); }
    }
    // A label, rail and value share a single row so paragraphs and margins
    // read as related adjustments inside each group (§3.3, §3.6, §4.4).
    HorizontalLayout {
        spacing: 8px;
        Text { width: 64px; text: root.label; color: ReaderTheme.ink; font-size: 13px; vertical-alignment: center; }
        Rectangle {
            height: 32px; horizontal-stretch: 1; border-radius: ReaderTheme.radius;
            border-width: slider-focus.has-focus ? 1px : 0px; border-color: ReaderTheme.accent;
            accessible-role: slider; accessible-label: root.label; accessible-enabled: root.enabled;
            accessible-value: root.value; accessible-value-minimum: root.minimum; accessible-value-maximum: root.maximum;
            accessible-value-step: root.step;
            accessible-action-set-value(v) => { if root.enabled && v.is-float() { root.set-value(v.to-float()); } }
            accessible-action-increment => { if root.enabled { root.set-value(root.value + root.step); } }
            accessible-action-decrement => { if root.enabled { root.set-value(root.value - root.step); } }
            forward-focus: slider-focus;
            rail := Rectangle {
                x: 8px; y: (parent.height - self.height) / 2; width: parent.width - 16px; height: 2px;
                border-radius: 1px; background: ReaderTheme.line;
                Rectangle { x: 0px; y: 0px; width: thumb.x - parent.x + 6px; height: parent.height; border-radius: 1px; background: ReaderTheme.accent; }
            }
            thumb := Rectangle {
                x: rail.x + rail.width * clamp((root.value - root.minimum) / (root.maximum - root.minimum),0,1) - 6px;
                y: (parent.height - self.height) / 2; width: 12px; height: 12px; border-radius: 6px; background: ReaderTheme.accent;
                border-width: 2px; border-color: ReaderTheme.surface;
            }
            slider-focus := FocusScope {
                enabled: root.enabled;
                key-pressed(event) => {
                    if event.text == Key.LeftArrow { root.set-value(root.value - root.step); return accept; }
                    if event.text == Key.RightArrow { root.set-value(root.value + root.step); return accept; }
                    if event.text == Key.Home { root.set-value(root.minimum); return accept; }
                    if event.text == Key.End { root.set-value(root.maximum); return accept; }
                    return reject;
                }
            }
            TouchArea {
                enabled: root.enabled; mouse-cursor: pointer;
                function seek() { root.set-value(root.minimum + (root.maximum - root.minimum) * ((self.mouse-x - rail.x) / rail.width)); }
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left { slider-focus.focus(); self.seek(); }
                }
                moved => { if self.pressed { self.seek(); } }
            }
        }
        LineEdit {
            width: 52px; height: 32px; enabled: root.enabled;
            text: "" + (round(root.value * 100) / 100);
            accepted => { root.entered(self.text); }
        }
        Text { width: 24px; text: root.unit; color: ReaderTheme.muted; font-size: 11px; vertical-alignment: center; }
    }
}

component PagePane inherits Rectangle {
    in property <image> source;
    in property <float> page-width;
    in property <float> page-height;
    in property <[Mark]> selection;
    in property <[Mark]> matches;
    in property <int> turn-mode: 0;
    in property <int> join-edge: 0;
    in property <bool> pannable: false;
    in property <bool> fit-preview: false;
    // Keep a whole PDF page fitted while the worker draws its new native tile.
    property <float> fit-scale: min(root.width / 1px / max(1,root.page-width),root.height / 1px / max(1,root.page-height));
    property <float> display-scale: root.fit-preview && root.page-width > 0 && root.page-height > 0 && abs(root.fit-scale - 1) > 0.006 ? root.fit-scale : 1;
    callback select-text(float,float,float,float);
    callback hit(float,float);
    callback wheel(float);
    callback pan(float,float);
    callback wheel-xy(float,float,bool,bool);
    callback navigate(int);
    min-width: 0px; min-height: 0px;
    preferred-width: 0px; preferred-height: 0px;
    horizontal-stretch: 1; vertical-stretch: 1;
    clip: true;
    image := Image {
        x: root.join-edge < 0 ? parent.width - self.width : root.join-edge > 0 ? 0px : (parent.width - self.width) / 2;
        y: max(0px, (parent.height - self.height) / 2);
        width: root.page-width * root.display-scale * 1px; height: root.page-height * root.display-scale * 1px;
        source: root.source; image-fit: contain;
        for mark in root.matches: Rectangle {
            x: mark.x * root.display-scale * 1px; y: mark.y * root.display-scale * 1px; width: mark.w * root.display-scale * 1px; height: mark.h * root.display-scale * 1px;
            background: #c9aa3658;
        }
        for mark in root.selection: Rectangle {
            x: mark.x * root.display-scale * 1px; y: mark.y * root.display-scale * 1px; width: mark.w * root.display-scale * 1px; height: mark.h * root.display-scale * 1px;
            background: #648d7855;
        }
    }
    touch := TouchArea {
        property <bool> tracking;
        property <PointerEventButton> button;
        property <bool> panning;
        property <bool> dragged;
        property <bool> on-paper;
        property <length> start-x;
        property <length> start-y;
        property <length> last-x;
        property <length> last-y;
        mouse-cursor: self.tracking && self.panning ? grabbing : root.pannable ? grab : default;

        function track() {
            if !self.tracking { return; }
            if !self.dragged && abs(self.mouse-x - self.start-x) + abs(self.mouse-y - self.start-y) < 4px { return; }
            self.dragged = true;
            if self.panning && (self.mouse-x != self.last-x || self.mouse-y != self.last-y) {
                root.pan((self.last-x - self.mouse-x)/1px,(self.last-y - self.mouse-y)/1px);
            }
            self.last-x = self.mouse-x; self.last-y = self.mouse-y;
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.cancel { self.tracking = false; }
            if e.kind == PointerEventKind.down && !self.tracking && (e.button == PointerEventButton.left ||
                    (root.pannable && (e.button == PointerEventButton.middle || e.button == PointerEventButton.right))) {
                self.tracking = true; self.button = e.button; self.dragged = false;
                self.panning = root.pannable && (e.button != PointerEventButton.left || !e.modifiers.shift);
                self.start-x = self.mouse-x; self.start-y = self.mouse-y;
                self.last-x = self.start-x; self.last-y = self.start-y;
                self.on-paper = self.start-x >= image.x && self.start-x < image.x + image.width &&
                    self.start-y >= image.y && self.start-y < image.y + image.height;
            }
            if e.kind == PointerEventKind.up && self.tracking && e.button == self.button {
                self.track();
                self.tracking = false;
                if e.button == PointerEventButton.left {
                    let x = (self.mouse-x - image.x)/1px/root.display-scale;
                    let y = (self.mouse-y - image.y)/1px/root.display-scale;
                    if !self.dragged {
                        if self.on-paper { root.hit(x,y); }
                        else { root.navigate(root.turn-mode != 0 ? root.turn-mode : self.mouse-x < self.width/2 ? -1 : 1); }
                    } else if !self.panning && self.on-paper {
                        root.select-text((self.start-x - image.x)/1px/root.display-scale,
                            (self.start-y - image.y)/1px/root.display-scale,x,y);
                    }
                }
            }
        }
        moved => { self.track(); }
        scroll-event(e) => { root.wheel-xy(e.delta-x/1px,e.delta-y/1px,e.modifiers.shift,e.modifiers.control); return accept; }
    }
}

// A circular instrument sits above the straight rail. The scale and legends have one
// axle at the top edge; only the reading index is fixed (§2.1, §6.1).
component ModeDrum inherits Rectangle {
    in property <int> count: 3;
    // Keep the resting coordinate in the same continuous space as the pull and
    // spring. The layout index is integral only when a detent is committed.
    in property <float> value;
    in property <length> radius;
    in property <length> label-radius;
    in property <float> lift;
    in property <image> lens;
    in property <bool> hit-enabled: true;
    callback choose(int); callback gripping(bool); callback indicated(float);
    property <float> raw;
    property <int> latch;
    property <bool> held;
    property <bool> dragged;
    property <bool> scrolling;
    property <length> previous-x;
    property <length> previous-y;
    property <length> origin-x;
    property <length> origin-y;
    property <float> snap-from;
    property <float> snap-to;
    property <duration> snap-start;
    property <bool> settling;
    property <float> t: root.settling ? clamp((animation-tick() - root.snap-start)/160ms,0,1) : 1;
    property <float> position: root.held || root.scrolling ? root.raw - 0.034*sin(root.raw*360deg)
        : root.settling ? root.snap-to + (root.snap-from - root.snap-to)*pow(1 - root.t,3)*(1 + root.t) : root.value;
    changed position => { root.indicated(root.position); }
    property <color> printing: ReaderTheme.dark ? #fafbf4 : #142524;
    property <color> secondary: ReaderTheme.dark ? #d5dfd7 : #3d504d;
    height: root.radius + 3px;
    accessible-role: slider; accessible-label: "阅读视图"; accessible-value: root.value == 2 ? "多页" : root.value == 1 ? "双页" : "单页";
    accessible-action-increment => { root.snap(root.value + 1); }
    accessible-action-decrement => { root.snap(root.value - 1); }
    forward-focus: focus;

    function snap(v: int) {
        let target = clamp(v,0,root.count - 1);
        root.snap-from = root.position;
        root.snap-to = target; root.snap-start = animation-tick();
        root.held = false; root.scrolling = false;
        root.settling = abs(root.snap-from - target) > 0.002;
        spring.running = false;
        if root.settling { spring.running = true; }
        if target != root.value { root.choose(target); }
    }
    function displace(distance: float) {
        root.raw = clamp(root.raw + distance,0,root.count - 1);
        if root.raw >= root.latch + 0.67 { root.latch = floor(root.raw + 0.33); }
        else if root.raw <= root.latch - 0.67 { root.latch = ceil(root.raw - 0.33); }
    }
    function pull() {
        if !root.held { return; }
        let x = touch.mouse-x; let y = touch.mouse-y;
        if abs(x - root.origin-x) + abs(y - root.origin-y) >= 2px { root.dragged = true; }
        if root.dragged {
            let dx = (x - root.previous-x)/1px; let dy = (y - root.previous-y)/1px;
            let rx = (root.previous-x - root.width/2)/1px; let ry = root.previous-y/1px;
            let r = max(1,sqrt(rx*rx + ry*ry));
            // A horizontal swipe has constant travel even past the rim. On the
            // curved edge, the tangent also follows a finger travelling vertically.
            let tangential = (ry*dx - rx*dy)/r;
            let blend = clamp((abs(dy) - abs(dx)*0.32)/max(1,abs(dy)),0,1);
            root.displace(-(dx*(1 - blend) + tangential*blend)/88);
            root.previous-x = x; root.previous-y = y;
        }
    }
    spring := Timer { interval: 164ms; running: false; triggered => { self.running = false; root.settling = false; } }
    release-wheel := Timer {
        interval: 310ms; running: false;
        // Scroll commits when it crosses the detent. Settling must respect a
        // layout selected elsewhere while the last wheel impulse was decaying.
        triggered => { self.running = false; root.snap(root.value); }
    }
    Image {
        x: parent.width/2 - root.radius - 6px; y: 0;
        width: 2*(root.radius + 6px); height: root.radius + 6px;
        image-fit: fill; source: root.lens;
    }
    for tooth in (root.count - 1)*8 + 1: Rectangle {
        property <angle> theta: tooth*6deg - root.position*48deg;
        property <bool> major: mod(tooth,4) == 0;
        property <length> track: root.radius - 8px;
        visible: abs(self.theta) <= 90deg;
        width: self.major ? 1.5px : 1px; height: self.major ? 6px : 3px;
        x: parent.width/2 + self.track*sin(self.theta) - self.width/2;
        y: self.track*cos(self.theta) - self.height/2;
        transform-rotation: -self.theta;
        background: root.secondary;
    }
    for name[i] in ["单页","双页","多页"]: Text {
        property <float> phase: i - root.position;
        property <angle> theta: self.phase*48deg;
        visible: i < root.count && abs(self.theta) < 70deg;
        width: 38px; height: 20px;
        x: parent.width/2 + root.label-radius*sin(self.theta) - self.width/2;
        y: root.label-radius*cos(self.theta) - self.height/2;
        opacity: clamp((70deg - abs(self.theta))/16deg,0,1);
        transform-rotation: -self.theta*0.62;
        text: name; font-size: 12px + 2px * root.lift + 2px * max(0,1 - abs(self.phase));
        font-weight: abs(self.phase) < 0.48 ? 600 : 400;
        color: abs(self.phase) < 0.48 ? root.printing : root.secondary;
        horizontal-alignment: center; vertical-alignment: center;
    }
    Rectangle {
        x: (parent.width - self.width)/2; y: root.radius - 4px;
        width: 3px; height: 4px; border-radius: 1px;
        background: ReaderTheme.dark ? #f1bb94 : #9b452e;
    }
    focus := FocusScope {
        key-pressed(e) => {
            if e.text == Key.UpArrow { root.snap(root.value - 1); return accept; }
            if e.text == Key.DownArrow { root.snap(root.value + 1); return accept; }
            if e.text == Key.Home { root.snap(0); return accept; }
            if e.text == Key.End { root.snap(root.count - 1); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.hit-enabled || root.held; mouse-cursor: root.held ? grabbing : grab;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                let here = root.position;
                release-wheel.running = false; spring.running = false;
                root.raw = here; root.latch = root.value; root.settling = false;
                root.scrolling = false; root.held = true; root.dragged = false;
                root.origin-x = self.mouse-x; root.previous-x = self.mouse-x;
                root.origin-y = self.mouse-y; root.previous-y = self.mouse-y; root.gripping(true);
            }
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.left && root.held {
                root.pull();
                let angle = atan2((self.mouse-x - self.width/2)/1px,max(2,self.mouse-y/1px));
                root.snap(root.dragged ? root.latch : root.value + round(angle/48deg));
                root.gripping(false);
            }
            if e.kind == PointerEventKind.cancel { root.snap(root.value); root.gripping(false); }
        }
        moved => { root.pull(); }
        scroll-event(e) => {
            let delta = (abs(e.delta-y) >= abs(e.delta-x) ? -e.delta-y : e.delta-x)/1px;
            if !root.held && delta != 0 {
                if !root.scrolling { root.raw = root.position; root.latch = root.value; }
                root.settling = false; root.scrolling = true;
                root.displace(clamp(delta,-60,60)/120);
                if root.latch != root.value { root.choose(root.latch); }
                release-wheel.interval = release-wheel.interval == 310ms ? 311ms : 310ms;
                release-wheel.running = true;
            }
            return accept;
        }
    }
}

component DialFace inherits Rectangle {
    in property <angle> turn;
    in property <float> lift;
    in property <image> lens;
    Image {
        x: -parent.width * 0.05; y: -parent.height * 0.05;
        width: parent.width * 1.10; height: parent.height * 1.10;
        source: root.lens; image-fit: fill; image-rendering: smooth;
    }
    Path {
        width: parent.width; height: parent.height; viewbox-width: 100; viewbox-height: 100;
        commands: "M10.4 65.7A42.6 42.6 0 1 1 89.6 65.7";
        fill: transparent; stroke: ReaderTheme.dark ? #b7bdb2 : #697569;
        stroke-width: 0.85px; opacity: 0.22 + root.lift*0.33;
    }
    Path {
        width: parent.width; height: parent.height; viewbox-width: 100; viewbox-height: 100;
        MoveTo { x: 50 + sin(root.turn)*29; y: 50 - cos(root.turn)*29; }
        LineTo { x: 50 + sin(root.turn)*45; y: 50 - cos(root.turn)*45; }
        fill: transparent; stroke: ReaderTheme.dark ? #efb192 : #a7472e;
        stroke-width: 1.65px + 0.75px * root.lift;
    }
}

component ZoomGrip inherits TouchArea {
    in property <length> cx;
    in property <length> cy;
    in property <length> radius;
    property <length> fixed-x;
    property <length> fixed-y;
    property <bool> travelled;
    callback started(float,float,float);
    callback motion(float,float,float,float) -> bool;
    callback released(float,float,bool);
    callback opened(int);
    callback cancelled();
    callback stepped(float);
    mouse-cursor: self.pressed ? grabbing : grab;
    property <length> press-x;
    property <length> press-y;
    property <int> pressed-mark;
    in property <bool> marks-enabled;
    callback pointed(int);
    pure function mark-at(dx: length, dy: length) -> int {
        if root.marks-enabled {
            if abs(dx + 22px) <= 11px && abs(dy - 21px) <= 8px { return 0; }
            if abs(dx) <= 11px && abs(dy - 30px) <= 8px { return 1; }
            if abs(dx - 22px) <= 11px && abs(dy - 21px) <= 8px { return 2; }
        }
        return -1;
    }
    function update-drag() {
        let x = self.mouse-x + self.absolute-position.x;
        let y = self.mouse-y + self.absolute-position.y;
        if abs(x - self.press-x) >= 4px || abs(y - self.press-y) >= 4px { self.travelled = true; }
        root.motion((x - self.fixed-x)/1px,(y - self.fixed-y)/1px,x/1px,y/1px);
    }
    pointer-event(e) => {
        if e.kind == PointerEventKind.cancel { root.cancelled(); }
        if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
            self.fixed-x = self.cx; self.fixed-y = self.cy;
            self.press-x = self.absolute-position.x + self.mouse-x;
            self.press-y = self.absolute-position.y + self.mouse-y; self.travelled = false;
            self.pressed-mark = self.mark-at(self.press-x - self.fixed-x,self.press-y - self.fixed-y);
            root.started((self.press-x - self.fixed-x)/1px,(self.press-y - self.fixed-y)/1px,self.radius/1px);
        }
        if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
            self.update-drag();
            root.released((self.absolute-position.x + self.mouse-x)/1px,(self.absolute-position.y + self.mouse-y)/1px,self.travelled);
            if !self.travelled { root.opened(self.pressed-mark); }
        }
    }
    moved => {
        if self.pressed { self.update-drag(); }
        else { root.pointed(self.mark-at(self.mouse-x + self.absolute-position.x - self.cx,self.mouse-y + self.absolute-position.y - self.cy)); }
    }
    changed has-hover => { if !self.has-hover { root.pointed(-1); } }
    scroll-event(e) => { if e.delta-y != 0px { root.stepped(e.delta-y/120px); } return accept; }
}

component PresetMark inherits Rectangle {
    in property <int> kind;
    in property <bool> selected;
    in property <bool> highlighted;
    callback clicked(); callback hover(bool);
    width: 22px; height: 15px;
    accessible-role: button; accessible-label: root.kind == 0 ? "整页，100%" : root.kind == 1 ? "适宽" : "铺满";
    accessible-action-default => { root.clicked(); } forward-focus: focus;
    Rectangle { x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; width: root.selected ? 2.2px : 1.5px; height: 4px; border-radius: 0.6px;
        transform-rotation: (root.kind - 1)*19deg;
        background: root.selected || focus.has-focus || root.highlighted ? (ReaderTheme.dark ? #ecb297 : #a94b31) : ReaderTheme.muted; }
    focus := FocusScope {
        changed has-focus => { root.hover(self.has-focus); }
        key-pressed(e) => { if e.text == Key.Return || e.text == " " { root.clicked(); return accept; } return reject; }
    }
}

component PageScrubber inherits Rectangle {
    in property <int> first;
    in property <int> last;
    in property <int> total;
    in property <bool> grouped;
    in property <bool> editing;
    callback jump(string) -> bool;
    callback edit();
    callback turned(int);
    callback active(bool);
    out property <int> preview-page: touch.pressed ? round(root.preview * max(0,root.total - 1)) + 1 : 0;
    property <float> preview;
    property <float> progress: touch.pressed ? root.preview : clamp((root.first - 1) / max(1,root.total - 1),0,1);
    property <string> current: root.preview-page > 0 ? "" + root.preview-page : root.last > root.first ? root.first + "–" + root.last : "" + root.first;
    property <string> total-text: "/ " + (root.total > 0 ? "" + root.total : "…");
    property <string> label: root.current + " " + root.total-text;
    // Reserve room for the longest visible range in this book. Seeking does
    // not move the beginning of the track when the page number gains a digit.
    property <length> number-width: max(16px,measure.preferred-width);
    property <length> folio-width: root.number-width + 6px + limit.preferred-width;
    property <bool> invalid: false;
    function activate-entry() {
        if root.editing {
            entry.text = "" + root.first;
            root.invalid = false;
            entry.focus(); entry.select-all();
        }
    }
    init => { root.activate-entry(); }
    changed editing => { root.activate-entry(); }
    height: 32px;
    measure := Text {
        visible: false; font-family: "Segoe UI"; font-size: 13px; font-weight: 600;
        text: "" + max(1,root.total) + (root.grouped ? "–" + max(1,root.total) : "");
    }
    folio := Text {
        x: 0px; y: 0px; width: root.number-width; height: parent.height;
        text: root.current; visible: !root.editing;
        font-family: "Segoe UI"; font-size: 13px; font-weight: 600;
        color: root.preview-page > 0 ? ReaderTheme.accent : ReaderTheme.ink;
        horizontal-alignment: left; vertical-alignment: center;
    }
    entry := TextInput {
        x: 0px; y: 0px; width: root.number-width; height: parent.height; visible: root.editing;
        single-line: true; input-type: number;
        font-family: "Segoe UI"; font-size: 13px; font-weight: 600; color: ReaderTheme.ink;
        horizontal-alignment: left; vertical-alignment: center;
        selection-background-color: ReaderTheme.accent.with-alpha(0.2); selection-foreground-color: ReaderTheme.ink;
        accessible-label: "输入页码，1 至 " + root.total;
        edited => { root.invalid = false; }
        accepted => { root.invalid = !root.jump(self.text); if root.invalid { self.select-all(); } }
    }
    limit := Text {
        x: (root.editing ? root.number-width : folio.preferred-width) + 6px; y: 0px; height: parent.height;
        text: root.total-text; font-family: "Segoe UI"; font-size: 13px;
        color: ReaderTheme.muted; vertical-alignment: center;
    }
    if root.editing || page-button.has-hover || page-focus.has-focus: Rectangle {
        x: 0px; y: parent.height - 7px;
        width: min(root.number-width,16px); height: 1px;
        background: root.editing && root.invalid ? ReaderTheme.invalid : ReaderTheme.accent;
    }
    page-focus := FocusScope {
        x: 0px; y: 0px; width: root.folio-width; height: parent.height;
        enabled: !root.editing && root.total > 0;
        key-pressed(e) => {
            if e.text == Key.Return || e.text == " " { root.edit(); return accept; }
            return reject;
        }
    }
    page-button := TouchArea {
        x: 0px; y: 0px; width: root.folio-width; height: parent.height;
        enabled: !root.editing && root.total > 0;
        mouse-cursor: pointer;
        accessible-role: button; accessible-enabled: self.enabled; accessible-label: root.label + "，输入页码跳转";
        accessible-action-default => { if self.enabled { root.edit(); } }
        clicked => { root.edit(); }
    }
    track := Rectangle {
        x: root.folio-width + 16px; y: (parent.height - self.height) / 2; width: max(8px,parent.width - self.x - 8px); height: 2px;
        background: ReaderTheme.line;
        Rectangle { x: 0px; y: 0px; width: parent.width * root.progress; height: parent.height; background: ReaderTheme.accent; }
        if root.total > 0: Rectangle {
            x: parent.width * root.progress - self.width / 2; y: (parent.height - self.height) / 2;
            width: touch.pressed ? 6px : 4px; height: 12px; border-radius: 2px; background: ReaderTheme.accent;
        }
    }
    touch := TouchArea {
        x: track.x - 6px; y: 0px; width: parent.width - self.x;
        enabled: root.total > 1 && !root.editing; mouse-cursor: pointer;
        accessible-role: slider; accessible-label: "阅读进度"; accessible-value: root.label;
        accessible-action-increment => { root.turned(1); }
        accessible-action-decrement => { root.turned(-1); }
        function fraction() -> float { return clamp((self.mouse-x - 6px) / track.width,0,1); }
        pointer-event(e) => {
            if e.kind == PointerEventKind.cancel { root.active(false); }
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.active(true); root.preview = self.fraction();
            }
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                let page = round(self.fraction() * (root.total - 1)) + 1;
                root.jump("" + page); root.active(false);
            }
        }
        moved => { if self.pressed { root.preview = self.fraction(); } }
        scroll-event(e) => { if e.delta-y != 0px { root.turned(e.delta-y < 0px ? 1 : -1); } return accept; }
    }
}

export component ReaderWindow inherits Window {
    title: root.book-title == "" ? "Sae Reader" : root.book-title + " · Sae Reader";
    icon: @image-url("../assets/window-icon.png");
    preferred-width: 1180px; preferred-height: 840px;
    min-width: 640px; min-height: 480px;
    default-font-family: "Microsoft YaHei UI";
    background: ReaderTheme.chrome;
    in-out property <bool> dark <=> ReaderTheme.dark;
    in-out property <color> canvas-color <=> ReaderTheme.paper;
    in property <int> design-variant: 0;
    init => { Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }
    changed dark => { Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }

    in property <[PageTile]> pages;
    in property <int> grid-rows: 1;
    out property <int> grid-columns: max(1, root.visible-count / max(1,root.grid-rows));
    in-out property <int> grid-choice: 0;
    property <[string]> grids: ["自动","3 × 1","4 × 1","2 × 2","3 × 2","4 × 2"];
    callback grid-changed(int);
    in property <int> visible-count: 1;
    in-out property <bool> pdf-multi: false;
    in property <string> book-title: "";
    in property <string> status: "";
    in property <string> notice: "";
    in property <int> first-page: 1;
    in property <int> last-page: 1;
    in property <int> page-total: 0;
    in property <bool> has-document: false;
    in-out property <bool> book-drag-over: false;
    // Rust decides whether to show the print before the first window is drawn.
    in property <bool> opening-document: true;
    pure callback glass(GlassView, [PageTile]) -> image;
    in property <int> page-revision;
    in property <bool> can-go-back;
    pure callback backdrop(PageScene, [PageTile], int) -> image;
    property <PageScene> page-scene: {paper:ReaderTheme.paper, viewport-w:canvas.width/1px, viewport-h:canvas.height/1px,
        columns:root.grid-columns, rows:root.grid-rows, flow:root.reflowable, inset:root.page-inset/1px,
        fit:!root.reflowable && root.pdf-zoom-stop == 1 && !root.pdf-pannable};
    property <image> empty-image;
    property <bool> needs-glass: root.has-document && (root.top-visible || root.bottom-visible || root.show-search
        || root.show-contents || root.show-settings || root.status != "");
    // Rust publishes a revision after replacing visible pixels in the same tile model.
    // All open panels reuse this field while the page and layout stay in place.
    out property <image> page-frost: root.has-document ? root.backdrop(root.page-scene,root.pages,root.page-revision) : root.empty-image;
    property <FrostMap> material: {picture: root.needs-glass ? root.page-frost : root.empty-image,
        w:canvas.width/1px, h:canvas.height/1px, dark:root.dark};
    pure callback negative-mark(image, CoverRect, bool) -> image;
    pure callback cover-tone(image, float, float, float, float) -> int;
    in property <bool> home-session: false;
    in property <int> home-variant;
    in property <image> home-frame;
    in property <int> home-frames;
    out property <image> home-picture: !root.home-session ? root.empty-image
        : root.home-variant == 0 && root.home-transition ? root.home-reveal-frame
        : root.home-frame.width > 0 ? root.home-frame : root.home-variant == 0 ? @image-url("../assets/frontispiece.svg")
        : root.home-variant == 2 ? @image-url("../assets/home/blue-still.png") : @image-url("../assets/home/plasma-still.png");
    in property <bool> home-transition;
    in property <float> home-reveal-progress;
    in property <image> home-reveal-frame;
    in property <int> home-reveal-frames;
    callback cycle-home(int);
    callback home-picker(bool);
    callback home-book-ready();
    callback home-resources() -> int;
    callback retire-home();
    in property <bool> reflowable: true;
    in property <[TocRow]> contents;
    in-out property <string> selected-content-uri;
    in property <[string]> fonts;
    in property <string> family-label: "默认衬线";
    in-out property <int> theme-index: 0;
    in-out property <bool> double-page: false;
    in-out property <bool> show-contents: false;
    in-out property <bool> show-settings: false;
    in-out property <bool> choice-open: false;
    in-out property <bool> show-search: false;
    in-out property <bool> show-toolbar: false;
    in-out property <bool> top-hover: false;
    in-out property <bool> bottom-hover: false;
    in-out property <bool> zoom-hover: false;
    in-out property <bool> zoom-pinned: false;
    in-out property <bool> zoom-dragging: false;
    in-out property <bool> is-fullscreen: false;
    in-out property <bool> controls-busy: false;
    in-out property <bool> page-entry-active: false;
    out property <bool> mode-dragging;
    out property <bool> top-visible: root.mode-dragging || !root.has-document || root.show-toolbar || root.top-hover || root.show-search || root.show-contents || root.show-settings;
    out property <bool> bottom-visible: root.has-document && (root.page-entry-active || root.zoom-lift > 0.001 || ((root.show-progress || !root.reflowable) && (root.show-toolbar || root.bottom-hover || root.controls-busy || root.zoom-pinned)));
    out property <bool> reading-keys: root.has-document && !root.show-search && !root.show-contents && !root.show-settings && !root.page-entry-active;
    in-out property <bool> show-progress: true;
    in-out property <bool> justified: false;
    in-out property <float> font-size-pt: 18;
    in-out property <float> line-height: 1.55;
    in-out property <float> paragraph-before: 0;
    in-out property <float> paragraph-after: 0.6;
    in-out property <float> indent: 1.5;
    in-out property <float> text-width: 720;
    in-out property <float> margin-top: 28;
    in-out property <float> margin-right: 40;
    in-out property <float> margin-bottom: 28;
    in-out property <float> margin-left: 40;
    out property <float> viewport-width: canvas.width / 1px;
    out property <float> viewport-height: canvas.height / 1px;
    in property <bool> effective-spread: false;
    in property <string> search-status: "";
    in property <float> pdf-zoom: 1;
    in property <float> pdf-fit-width-zoom: 1;
    in property <float> pdf-fill-zoom: 1;
    in property <int> pdf-zoom-stop: 1;
    in property <bool> pdf-pannable: false;
    in property <int> page-color: 0;
    in property <bool> text-document: false;
    in property <string> encoding-label: "";
    in property <string> encoding-choice: "自动检测";
    property <length> window-inset: 16px;
    property <length> header-height: 52px;
    out property <length> header-height-logical: root.header-height;
    property <length> rest-radius: 64px;
    property <length> open-radius: 78px;
    out property <length> mode-span: 2 * (root.open-radius + 6px);
    out property <length> mode-center-x: root.width - root.window-inset - 88px - root.mode-span/2;
    property <bool> mode-hot;
    property <bool> mode-hit-enabled: true;
    in-out property <float> mode-position;
    property <length> mode-radius: root.mode-hot || root.mode-dragging ? root.open-radius : root.rest-radius;
    out property <length> mode-label-radius: root.mode-radius*0.63;
    out property <length> mode-depth: root.mode-radius - root.header-height;
    animate mode-radius { duration: 145ms; easing: cubic-bezier(0.2,0.7,0.2,1); }
    out property <length> panel-top: root.open-radius + ReaderTheme.pad;
    out property <length> dock-height: 48px;
    property <length> dock-width: min(root.reflowable ? 424px : root.show-progress || root.page-entry-active ? 516px : 100px,root.width - 2 * root.window-inset);
    out property <length> dock-left: (root.width - root.dock-width) / 2;
    out property <length> dock-right: root.dock-left + root.dock-width;
    out property <length> dock-top: root.height - root.dock-height - 12px;
    property <length> side-panel-height: root.dock-top - root.panel-top - 12px;
    property <length> side-panel-width: 352px;
    out property <bool> show-zoom-pop: root.has-document && !root.reflowable && (root.zoom-hover || root.zoom-pinned || root.zoom-dragging) && !root.page-entry-active;
    property <float> captured-lift;
    property <float> zoom-lift: root.zoom-dragging ? root.captured-lift : root.reveal-lift;
    property <float> reveal-lift: root.show-zoom-pop ? 1 : 0;
    animate reveal-lift { duration: 180ms; easing: cubic-bezier(0.22,0.68,0.13,1); }
    out property <length> knob-pop-width: 100px;
    out property <length> knob-pop-height: 48px;
    out property <bool> zoom-can-cover: root.pdf-fill-zoom > root.pdf-fit-width-zoom * 1.035;
    out property <length> knob-pop-left: root.dock-right - root.knob-pop-width;
    out property <length> knob-pop-top: root.dock-top - root.knob-pop-height;
    pure function dial-x(lift: float) -> length { return root.dock-right - 73px + 23px * lift; }
    pure function dial-y(lift: float) -> length { return root.dock-top + 24px - 24px * lift; }
    pure function dial-radius(lift: float) -> length { return 12px + 22px * lift; }
    out property <length> knob-center-x: root.dial-x(root.zoom-lift);
    out property <length> knob-center-y: root.dial-y(root.zoom-lift);
    out property <length> knob-radius: root.dial-radius(root.zoom-lift);
    property <length> dock-rise: root.knob-pop-height * root.zoom-lift;
    out property <length> readout-x: root.dock-right - 30px - 20px * root.zoom-lift;
    out property <length> readout-y: root.knob-center-y;
    out property <length> preset-page-x: root.knob-center-x - 22px;
    out property <length> preset-width-x: root.knob-center-x;
    out property <length> preset-page-y: root.knob-center-y + 21px;
    out property <length> preset-width-y: root.knob-center-y + 30px;
    property <int> preset-hover: -1;
    property <bool> presets-ready;
    arm-presets := Timer {
        interval: 180ms; running: false;
        triggered => { self.running = false; root.presets-ready = root.show-zoom-pop; }
    }
    function disarm-presets() {
        arm-presets.running = false; root.presets-ready = false; root.preset-hover = -1;
    }
    property <length> page-inset: root.reflowable ? 16px : 0px;
    callback open-file(); callback next-page(int); callback back();
    callback typography(string,float); callback resized(); callback follow-link(string);
    callback setting-text(string,string); callback mode-changed(bool); callback theme-changed(int);
    callback multi-mode();
    callback fonts-needed(); callback wheel(float);
    callback choice-index([string],string) -> int;
    callback select-text(int,float,float,float,float); callback hit(int,float,float); callback copy-text();
    callback search(string); callback search-next(int); callback fullscreen();
    callback pan(float,float); callback encoding-changed(string); callback page-color-changed(int);
    callback wheel-xy(float,float,bool,bool); callback jump-page(string) -> bool;
    callback zoom-begin(float,float,float); callback zoom-motion(float,float,float,float) -> bool;
    callback zoom-end(); callback refresh-zoom(bool);
    public function edge-hover(x: float, y: float) {
        let px = x * 1px; let py = y * 1px;
        if px < 0px || px >= root.width || py < 0px || py >= root.height {
            root.top-hover = false; root.bottom-hover = false; root.mode-hot = false; root.mode-hit-enabled = true;
            if !root.controls-busy { root.zoom-hover = false; }
            return;
        }
        // Enter well inside the canvas, then give the pointer a wider exit band.
        let reveal = clamp(root.height * 0.08,44px,72px);
        let dx = (px - root.mode-center-x)/1px; let dy = py/1px;
        let distance2 = dx*dx + dy*dy;
        // Reveal just before the pointer reaches the glass and keep the
        // expanded rim steady while its painted radius is still catching up.
        let reach = (root.mode-hot || root.mode-dragging ? root.open-radius + 4px : root.rest-radius + 8px)/1px;
        root.mode-hot = distance2 <= reach*reach;
        let rim = root.mode-radius/1px + 1;
        root.mode-hit-enabled = distance2 <= rim*rim || (py <= root.header-height && root.mode-hot);
        root.top-hover = root.mode-hot || py <= (root.top-hover ? max(reveal + 12px,root.header-height + 12px) : reveal);
        let in-knob = px >= root.dock-right - 100px && px <= root.dock-right && py >= root.dock-top;
        let in-pop = root.show-zoom-pop && px >= root.knob-pop-left && px <= root.dock-right && py >= root.knob-pop-top && py < root.dock-top;
        if !root.controls-busy { root.zoom-hover = !root.reflowable && root.has-document && (in-knob || in-pop); }
        if root.zoom-hover && !root.presets-ready && !arm-presets.running { arm-presets.running = true; }
        root.bottom-hover = root.zoom-hover || py >= root.height - (root.bottom-hover ? max(reveal + 12px,root.dock-height + 24px) : reveal);
    }
    function start-zoom(x: float, y: float, radius: float) {
        root.focus-reading();
        root.captured-lift = root.zoom-lift; root.preset-hover = -1;
        root.controls-busy = true;
        root.zoom-dragging = true;
        root.zoom-begin(x,y,radius);
    }
    function end-zoom() {
        root.zoom-dragging = false;
        root.controls-busy = false;
        root.zoom-end();
    }
    function release-zoom(x: float, y: float, travelled: bool) {
        if travelled { root.zoom-pinned = true; }
        root.end-zoom();
        root.edge-hover(x,y);
    }
    public function focus-reading() { root.page-entry-active = false; keyboard.focus(); }
    public function dismiss-panels() {
        root.disarm-presets();
        if root.show-search { root.search(""); }
        root.show-contents = false; root.show-settings = false; root.show-search = false;
        root.zoom-pinned = false; root.zoom-hover = false;
        root.focus-reading();
    }
    public function focus-search() {
        if root.has-document {
            root.page-entry-active = false; root.show-settings = false; root.show-contents = false; root.show-search = true;
            root.zoom-pinned = false; query.focus();
        }
    }
    public function focus-page-entry() {
        if root.has-document && root.page-total > 0 {
            root.show-contents = false; root.show-settings = false; root.show-search = false; root.zoom-pinned = false;
            root.page-entry-active = true;
        }
    }
    changed show-zoom-pop => {
        if root.show-zoom-pop { if !root.presets-ready { arm-presets.running = true; } }
        else { root.disarm-presets(); }
    }
    changed viewport-width => { root.resized(); }
    changed viewport-height => { root.resized(); }
    changed show-settings => { if root.show-settings && root.reflowable { root.fonts-needed(); } if !root.show-settings { root.choice-open = false; } }
    forward-focus: keyboard;

    keyboard := FocusScope {
        // Also handle platform-dispatched keys (e.g. accessibility and QA).
        capture-key-pressed(event) => {
            if root.home-session && !root.opening-document && !root.home-transition && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta {
                if event.text == Key.LeftArrow { root.cycle-home(-1); return accept; }
                if event.text == Key.RightArrow { root.cycle-home(1); return accept; }
            }
            if root.reading-keys && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta {
                if event.text == Key.RightArrow || event.text == Key.PageDown { root.next-page(1); return accept; }
                if event.text == Key.LeftArrow || event.text == Key.PageUp { root.next-page(-1); return accept; }
            }
            return reject;
        }
        key-pressed(event) => {
            if event.modifiers.control && (event.text == "o" || event.text == "O") { root.open-file(); return accept; }
            if event.modifiers.control && (event.text == "f" || event.text == "F") { root.focus-search(); return accept; }
            if event.modifiers.control && (event.text == "c" || event.text == "C") { root.copy-text(); return accept; }
            if root.reading-keys && event.text == " " { root.next-page(1); return accept; }
            if event.text == Key.Escape && !root.choice-open { root.dismiss-panels(); return accept; }
            if event.text == Key.F11 { root.fullscreen(); return accept; }
            if event.text == Key.F10 { root.show-toolbar = !root.show-toolbar; return accept; }
            if root.reading-keys && event.text == Key.UpArrow { if root.pdf-pannable { root.pan(0,-120); } else { root.next-page(-1); } return accept; }
            if root.reading-keys && event.text == Key.DownArrow { if root.pdf-pannable { root.pan(0,120); } else { root.next-page(1); } return accept; }
            if event.modifiers.control && (event.text == "+" || event.text == "=") { root.typography("delta-size",1); return accept; }
            if event.modifiers.control && event.text == "-" { root.typography("delta-size",-1); return accept; }
            if event.modifiers.control && event.text == "0" { root.typography("size",18); return accept; }
            return reject;
        }

        canvas := Rectangle {
            background: ReaderTheme.paper; clip: true;
            if !root.home-session && !root.has-document && root.opening-document: Text {
                text: root.status; color: ReaderTheme.muted; font-size: 13px;
                horizontal-alignment: center; vertical-alignment: center;
            }
            if root.has-document: TouchArea {
                clicked => { if root.zoom-pinned { root.dismiss-panels(); } else { keyboard.focus(); root.next-page(self.mouse-x < self.width / 2 ? -1 : 1); } }
                scroll-event(e) => { root.wheel-xy(e.delta-x / 1px,e.delta-y / 1px,e.modifiers.shift,e.modifiers.control); return accept; }
            }
            for tile[i] in root.pages: PagePane {
                property <int> column: mod(i,root.grid-columns);
                x: self.column * parent.width / root.grid-columns + root.page-inset;
                y: floor(i / root.grid-columns) * parent.height / root.grid-rows;
                width: parent.width / root.grid-columns - 2 * root.page-inset;
                height: parent.height / root.grid-rows;
                source: tile.source; page-width: tile.w; page-height: tile.h;
                selection: tile.selection; matches: tile.matches; pannable: root.pdf-pannable;
                fit-preview: !root.reflowable && root.pdf-zoom-stop == 1 && !root.pdf-pannable;
                turn-mode: 2 * self.column + 1 < root.grid-columns ? -1 : 2 * self.column + 1 > root.grid-columns ? 1 : 0;
                join-edge: !root.reflowable && root.grid-columns == 2 ? self.turn-mode : 0;
                select-text(a,b,c,d) => { if root.zoom-pinned { root.dismiss-panels(); } keyboard.focus(); root.select-text(i,a,b,c,d); }
                hit(a,b) => { if root.zoom-pinned { root.dismiss-panels(); } else { keyboard.focus(); root.hit(i,a,b); } }
                wheel-xy(x,y,s,c) => { root.wheel-xy(x,y,s,c); }
                pan(x,y) => { root.pan(x,y); }
                navigate(d) => { if root.zoom-pinned { root.dismiss-panels(); } else { keyboard.focus(); root.next-page(d); } }
            }
            // Created only while a side panel is open. It consumes the complete
            // first gesture, so closing cannot also follow a link or turn a page.
            if root.show-settings || root.show-contents || root.show-search || root.page-entry-active: TouchArea {
                clicked => {
                    root.dismiss-panels();
                }
            }
        }

        // These panels overlay a stable full-size reading canvas. Hovering does
        // not invoke native pagination, resize the page or allocate new images.
        if root.has-document && root.top-visible: Rectangle {
            x: 0px; y: 0px; width: parent.width; height: root.header-height;
            background: ReaderTheme.chrome;
            FrostFace { width: parent.width; height: parent.height; material:root.material; kind:FrostKind.rail; corner:0px; }
            Rectangle { y: parent.height; width: parent.width; height: 2px; background: @linear-gradient(180deg, ReaderTheme.contact, transparent); }
            Rectangle { x: root.window-inset; y: 1px; width: parent.width - 2 * self.x; height: 1px; background: ReaderTheme.edge; }
            Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: ReaderTheme.line; }
            TouchArea {}
            HorizontalLayout {
                width: parent.width; height: ReaderTheme.button-height; y: (parent.height - self.height)/2;
                padding-left: root.window-inset; padding-right: root.window-inset; spacing: 8px;
                QuietButton { icon: @image-url("../assets/icons/open.svg"); label: "打开书籍"; clicked => { root.open-file(); } }
                Rectangle { width: 1px; Rectangle { y: (parent.height - self.height) / 2; width: 1px; height: 16px; background: ReaderTheme.line; } }
                Text { text: root.book-title; font-size: 15px; font-weight: 600; color: ReaderTheme.ink; horizontal-stretch: 1; min-width: 0px; overflow: elide; vertical-alignment: center; }
                if root.has-document && root.can-go-back: QuietButton { text: root.width > 780px ? "回到跳转前" : "↶"; label: "回到目录或链接跳转前的位置"; clicked => { root.back(); root.focus-reading(); } }
                if root.has-document: QuietButton { icon: @image-url("../assets/icons/contents.svg"); label: "目录"; selected: root.show-contents; clicked => { root.show-contents = !root.show-contents; root.show-settings = false; root.show-search = false; root.focus-reading(); } }
                if root.has-document: QuietButton { icon: @image-url("../assets/icons/search.svg"); label: "全文查找"; selected: root.show-search; clicked => { if root.show-search { root.dismiss-panels(); } else { root.focus-search(); } } }
                Rectangle { width: root.mode-span; horizontal-stretch: 0; }
                QuietButton { icon: @image-url("../assets/icons/settings.svg"); label: "阅读设置"; selected: root.show-settings; clicked => { root.show-settings = !root.show-settings; root.show-contents = false; root.show-search = false; root.focus-reading(); } }
                QuietButton { icon: @image-url("../assets/icons/fullscreen.svg"); label: root.is-fullscreen ? "退出全屏" : "全屏"; selected: root.is-fullscreen; clicked => { root.fullscreen(); } }
            }
        }
        if root.has-document && root.top-visible: ModeDrum {
            x: root.mode-center-x - self.width/2; y: 0; width: root.mode-span;
            // Keep sampling independent of the scale and legends moving above the lens.
            lens: root.glass({center:root.mode-center-x/1px, radius:round(root.mode-radius/2px)*2,
                rail:root.header-height/1px, density:1px/1phx, chrome:ReaderTheme.chrome, dark:root.dark, scene:root.page-scene},
                [root.pages[0],root.pages[1],root.pages[2],root.pages[3]]);
            radius: root.mode-radius; label-radius: root.mode-label-radius;
            lift: (root.mode-radius - root.rest-radius)/(root.open-radius - root.rest-radius);
            indicated(p) => { root.mode-position = p; } hit-enabled: root.mode-dragging || root.mode-hit-enabled;
            count: root.reflowable ? 2 : 3;
            gripping(v) => { root.mode-dragging = v; if !v { root.focus-reading(); } }
            value: !root.reflowable && root.pdf-multi ? 2 : root.double-page ? 1 : 0;
            choose(index) => {
                root.pdf-multi = index == 2;
                if index == 2 { root.multi-mode(); }
                else { root.double-page = index == 1; root.mode-changed(root.double-page); }
                root.focus-reading();
            }
        }
        searchbar := RaisedPanel {
            material: root.material;
            visible: root.show-search;
            x: parent.width - self.width - root.window-inset; y: root.panel-top;
            width: min(520px,parent.width - 2 * root.window-inset); height: root.search-status == "" ? 56px : 88px;
            VerticalLayout {
                padding: 12px; spacing: 8px;
                HorizontalLayout {
                    spacing: 4px;
                    query := LineEdit { height: 32px; placeholder-text: "搜索全文"; accepted => { root.search(self.text); } }
                    QuietButton { text: "查找"; clicked => { root.search(query.text); } }
                    QuietButton { text: "上处"; clicked => { root.search-next(-1); } }
                    QuietButton { text: "下处"; clicked => { root.search-next(1); } }
                    QuietButton { icon: @image-url("../assets/icons/close.svg"); label: "关闭查找"; clicked => { root.dismiss-panels(); } }
                }
                if root.search-status != "": Text {
                    height: 24px; text: root.search-status; color: ReaderTheme.muted; font-size: 12px; overflow: elide;
                    vertical-alignment: center;
                }
            }
        }
        if root.show-contents: RaisedPanel {
            material: root.material;
            x: root.window-inset; y: root.panel-top; width: min(root.side-panel-width,parent.width - 2 * root.window-inset);
            height: root.contents.length == 0 ? 112px : root.side-panel-height;
            PanelHeading { width: parent.width; title: "目录"; icon: @image-url("../assets/icons/contents.svg"); closed => { root.dismiss-panels(); } }
            if root.contents.length == 0: Text {
                x: ReaderTheme.pad; y: 52px; height: 56px;
                text: "这份文档没有目录"; font-size: 13px; color: ReaderTheme.muted; vertical-alignment: center;
            }
            if root.contents.length > 0: ListView {
                    x: 8px; y: 60px; width: parent.width - 16px; height: parent.height - 68px;
                    horizontal-scrollbar-policy: always-off;
                    content-width: self.visible-width;
                    for row in root.contents: Rectangle {
                    // ListView instantiates visible rows only. A growing title
                    // gets its real height and never shares the scrollbar lane.
                    width: parent.width - 16px; height: max(row.depth == 0 ? 44px : 36px,toc-title.preferred-height + 16px); border-radius: ReaderTheme.radius;
                    background: row.uri == root.selected-content-uri || toc-touch.has-hover || toc-focus.has-focus ? ReaderTheme.tint : transparent;
                    accessible-role: button; accessible-label: row.title;
                    accessible-action-default => { root.follow-link(row.uri); root.show-contents = false; keyboard.focus(); }
                    forward-focus: toc-focus;
                    if row.depth > 0: Rectangle {
                        x: 12px + (min(row.depth,5) - 1) * 12px;
                        y: 0px; width: 1px; height: parent.height; background: ReaderTheme.line;
                    }
                    if row.uri == root.selected-content-uri || toc-focus.has-focus: Rectangle { x: 4px; y: 8px; width: 2px; height: parent.height - 16px; border-radius: 1px; background: ReaderTheme.accent; }
                    toc-title := Text {
                        x: 16px + min(row.depth,5) * 12px; y: (parent.height - self.height) / 2;
                        width: parent.width - self.x - 8px; height: self.preferred-height;
                        text: row.title; wrap: word-wrap; vertical-alignment: top;
                        font-family: row.latin && row.depth == 0 ? "Georgia" : row.latin ? "Segoe UI" : "Microsoft YaHei UI";
                        font-size: 14px; font-weight: row.uri == root.selected-content-uri ? 600 : 400;
                        color: row.uri == root.selected-content-uri ? ReaderTheme.accent : row.depth == 0 ? ReaderTheme.ink : ReaderTheme.muted;
                    }
                    toc-focus := FocusScope { key-pressed(e) => { if e.text == Key.Return || e.text == " " { root.follow-link(row.uri); root.show-contents = false; keyboard.focus(); return accept; } return reject; } }
                    toc-touch := TouchArea { mouse-cursor: pointer; clicked => { root.follow-link(row.uri); root.show-contents = false; keyboard.focus(); } }
                }
            }
        }
        if root.show-settings: RaisedPanel {
            material: root.material;
            x: parent.width - self.width - root.window-inset; y: root.panel-top;
            width: min(root.side-panel-width,parent.width - 2 * root.window-inset);
            height: min(root.side-panel-height,53px + settings-form.preferred-height);
            PanelHeading {
                width: parent.width;
                title: root.reflowable ? "阅读排版" : "页面设置";
                icon: @image-url("../assets/icons/settings.svg"); closed => { root.dismiss-panels(); }
            }
            settings-scroll := ScrollView {
                x: 1px; y: 52px; width: parent.width - 2px; height: parent.height - 53px;
                horizontal-scrollbar-policy: always-off;
                content-width: self.width;
                content-height: settings-form.preferred-height;
                settings-form := VerticalLayout {
                    width: settings-scroll.width; height: self.preferred-height;
                    padding-left: ReaderTheme.pad; padding-right: ReaderTheme.pad; padding-top: 12px; padding-bottom: ReaderTheme.pad;
                    spacing: 20px;
                    VerticalLayout {
                        spacing: 4px;
                        GroupLabel { text: "主题"; }
                        HorizontalLayout {
                            height: 32px; spacing: 4px;
                            QuietButton { text: "暖纸"; swatch: #f8f6f1; selected: root.theme-index==0; clicked => { root.theme-changed(0); } }
                            QuietButton { text: "白纸"; swatch: #ffffff; selected: root.theme-index==1; clicked => { root.theme-changed(1); } }
                            QuietButton { text: "夜读"; swatch: #171a19; selected: root.theme-index==2; clicked => { root.theme-changed(2); } }
                        }
                    }
                    if !root.reflowable: VerticalLayout {
                        spacing: 4px;
                        GroupLabel { text: "页面颜色"; }
                        Rectangle {
                            height: 36px; border-radius: ReaderTheme.radius; background: ReaderTheme.well;
                            HorizontalLayout {
                                padding: 2px; spacing: 4px;
                                QuietButton { text: "原色"; selected: root.page-color==0; clicked => { root.page-color-changed(0); } }
                                QuietButton { text: "随主题"; selected: root.page-color==1; clicked => { root.page-color-changed(1); } }
                                QuietButton { text: "反色"; selected: root.page-color==2; clicked => { root.page-color-changed(2); } }
                            }
                        }
                    }
                    if root.reflowable: VerticalLayout {
                        spacing: 4px;
                        GroupLabel { text: "文字"; }
                        ChoiceField {
                            material: root.material;
                            label: "字体"; model: root.fonts; value: root.family-label; window-height: root.height;
                            current-index(items,v) => { return root.choice-index(items,v); }
                            expanded(v) => { root.choice-open = v; } selected(v) => { root.setting-text("family",v); }
                        }
                        SettingField { label: "字号"; unit: "pt"; minimum:12; maximum:36; value <=> root.font-size-pt; edited(v)=>{root.typography("size",v);} entered(s)=>{root.setting-text("size",s);} }
                        SettingField { label: "行距"; unit: "倍"; minimum:1.15; maximum:2.2; value <=> root.line-height; edited(v)=>{root.typography("line",v);} entered(s)=>{root.setting-text("line",s);} }
                    }
                    if root.reflowable: VerticalLayout {
                        spacing: 4px;
                        GroupLabel { text: "段落"; }
                        SettingField { label: "段前"; unit: "em"; minimum:0; maximum:2; value <=> root.paragraph-before; edited(v)=>{root.typography("before",v);} entered(s)=>{root.setting-text("before",s);} }
                        SettingField { label: "段后"; unit: "em"; minimum:0; maximum:2; value <=> root.paragraph-after; edited(v)=>{root.typography("paragraph",v);} entered(s)=>{root.setting-text("paragraph",s);} }
                        SettingField { label: "首行缩进"; unit: "em"; minimum:0; maximum:2.5; value <=> root.indent; edited(v)=>{root.typography("indent",v);} entered(s)=>{root.setting-text("indent",s);} }
                        PanelToggle { text: "两端对齐"; checked <=> root.justified; toggled => {root.typography("justify",self.checked?1:0);} }
                    }
                    if root.reflowable: VerticalLayout {
                        spacing: 4px;
                        GroupLabel { text: "页面"; }
                        SettingField { label: "正文宽度"; unit: "px"; minimum:260; maximum:1200; value <=> root.text-width; edited(v)=>{root.typography("width",v);} entered(s)=>{root.setting-text("width",s);} }
                        SettingField { label: "上边距"; unit: "pt"; minimum:0; maximum:100; value <=> root.margin-top; edited(v)=>{root.typography("top",v);} entered(s)=>{root.setting-text("top",s);} }
                        SettingField { label: "下边距"; unit: "pt"; minimum:0; maximum:100; value <=> root.margin-bottom; edited(v)=>{root.typography("bottom",v);} entered(s)=>{root.setting-text("bottom",s);} }
                        SettingField { label: "左边距"; unit: "pt"; minimum:0; maximum:100; value <=> root.margin-left; edited(v)=>{root.typography("left",v);} entered(s)=>{root.setting-text("left",s);} }
                        SettingField { label: "右边距"; unit: "pt"; minimum:0; maximum:100; value <=> root.margin-right; edited(v)=>{root.typography("right",v);} entered(s)=>{root.setting-text("right",s);} }
                    }
                    if !root.reflowable && root.pdf-multi: VerticalLayout {
                        spacing: 4px;
                        GroupLabel { text: "多页布局"; }
                        ChoiceField { material: root.material; label: "多页布局"; model: root.grids; value: root.grids[root.grid-choice]; window-height: root.height;
                            current-index(items,v) => { return root.choice-index(items,v); }
                            expanded(v) => { root.choice-open = v; }
                            selected(v) => { root.grid-choice = root.choice-index(root.grids,v); root.grid-changed(root.grid-choice); } }
                    }
                    if root.text-document: VerticalLayout {
                        spacing: 4px;
                        GroupLabel { text: "文本编码"; }
                        ChoiceField {
                            material: root.material;
                            label: "文本编码"; model: ["自动检测","UTF-8","UTF-16LE","UTF-16BE","GB18030","Big5","Shift_JIS","windows-1252"]; value: root.encoding-choice; window-height: root.height;
                            current-index(items,v) => { return root.choice-index(items,v); }
                            expanded(v) => { root.choice-open = v; } selected(v) => { root.encoding-changed(v); }
                        }
                        Text { text: root.encoding-label; color: ReaderTheme.muted; font-size: 12px; }
                    }
                    if root.notice != "": VerticalLayout {
                        spacing: 4px;
                        GroupLabel { text: "文档信息"; }
                        Text {
                            text: root.notice; wrap: word-wrap;
                            color: ReaderTheme.muted; font-size: 12px;
                        }
                    }
                    HorizontalLayout {
                        height: 32px; spacing: 8px;
                        PanelToggle { text: "阅读进度"; horizontal-stretch: 0; checked <=> root.show-progress; toggled=>{root.typography("progress",self.checked?1:0);} }
                        Rectangle { horizontal-stretch: 1; }
                        if root.reflowable: QuietButton { text: "恢复默认"; clicked=>{root.typography("reset",0);} }
                    }
                }
            }
        }

        if root.bottom-visible: Rectangle {
            x: root.dock-left; y: root.dock-top; width: root.dock-width; height: root.dock-height;
            pure function edge-tone(fraction: float) -> color {
                return Materials.dock-edge(root.material,(root.dock-left + fraction*root.dock-width)/1px,(root.dock-top + root.dock-height/2)/1px);
            }
            property <brush> edge-fill: @linear-gradient(90deg, self.edge-tone(0), self.edge-tone(0.5), self.edge-tone(1));
            DockOutline {
                y: ReaderTheme.contact-depth - root.dock-rise; width: parent.width; height: parent.height + root.dock-rise;
                rise: root.dock-rise; has-track: root.show-progress || root.page-entry-active; fill: ReaderTheme.contact;
            }
            DockOutline {
                y: -root.dock-rise; width: parent.width; height: parent.height + root.dock-rise;
                rise: root.dock-rise; has-track: root.show-progress || root.page-entry-active; fill: ReaderTheme.seam;
            }
            DockOutline {
                x: 1px; y: 1px - root.dock-rise; width: parent.width - 2px; height: parent.height + root.dock-rise - 2px;
                rise: root.dock-rise; bay: 99px; has-track: root.show-progress || root.page-entry-active; fill: parent.edge-fill;
            }
            FrostFace {
                y: -root.dock-rise; width: parent.width; height: parent.height + root.dock-rise; material: root.material;
                kind: FrostKind.dock; corner: 17px; rise: root.show-progress || root.page-entry-active ? root.dock-rise : 0px;
            }
            TouchArea {}
            Rectangle {
                x: 16px; y: 0px; width: parent.width - 32px; height: parent.height;
                if root.show-progress || root.page-entry-active: PageScrubber {
                    x: 0px; y: (parent.height - self.height) / 2;
                    width: parent.width - (root.reflowable ? 0px : 94px);
                    first: root.first-page; last: root.last-page; total: root.page-total; editing: root.page-entry-active;
                    grouped: root.effective-spread;
                    edit => { root.focus-page-entry(); }
                    jump(v) => { let ok = root.jump-page(v); if ok { root.focus-reading(); } return ok; }
                    turned(d) => { root.next-page(d); }
                    active(v) => { root.controls-busy = v; if v { root.zoom-pinned = false; root.zoom-hover = false; } }
                }

            }
        }
        if root.bottom-visible && !root.reflowable: Rectangle {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            DialFace {
                x: root.knob-center-x - root.knob-radius; y: root.knob-center-y - root.knob-radius;
                width: root.knob-radius * 2; height: self.width; lift: root.zoom-lift;
                // Sample the resting or raised footprint once. Slint moves and
                // scales that one image through the lift, independently of the index.
                property <float> material-pose: root.zoom-dragging ? root.captured-lift : root.show-zoom-pop ? 1 : 0;
                lens: Materials.zoom-lens({picture:root.page-frost,w:root.viewport-width,h:root.viewport-height,dark:root.dark},
                    root.dial-x(self.material-pose)/1px,root.dial-y(self.material-pose)/1px,
                    root.dial-radius(self.material-pose)/1px,1px/1phx);
                turn: 180deg * log(clamp(root.pdf-zoom,0.25,8),2);
            }
            Text {
                x: root.readout-x - self.width/2; y: root.readout-y - self.height/2; width: 58px; height: 24px;
                text: root.show-zoom-pop && !root.zoom-dragging && root.preset-hover >= 0 ? (root.preset-hover == 0 ? "整页" : root.preset-hover == 1 ? "适宽" : "铺满") : round(root.pdf-zoom * 100) + "%"; horizontal-alignment: center; vertical-alignment: center;
                font-family: "Segoe UI"; font-size: 13px + root.zoom-lift * 2px; font-weight: 600;
                color: ReaderTheme.ink;
            }
            if root.zoom-lift > 0.08: Rectangle {
                width: parent.width; height: parent.height; opacity: clamp((root.zoom-lift - 0.08)/0.92,0,1);
                PresetMark { x: root.knob-center-x - 22px * root.zoom-lift - self.width / 2;
                    y: root.knob-center-y + 21px * root.zoom-lift - self.height / 2; kind: 0; highlighted: root.preset-hover == self.kind; selected: root.pdf-zoom-stop == 1;
                    hover(v) => { if v { root.preset-hover = self.kind; } else if root.preset-hover == self.kind { root.preset-hover = -1; } }
                    clicked => { root.typography("fit-page",0); root.focus-reading(); } }
                PresetMark { x: root.knob-center-x - self.width / 2;
                    y: root.knob-center-y + 30px * root.zoom-lift - self.height / 2; kind: 1; highlighted: root.preset-hover == self.kind; selected: root.pdf-zoom-stop == 3;
                    hover(v) => { if v { root.preset-hover = self.kind; } else if root.preset-hover == self.kind { root.preset-hover = -1; } }
                    clicked => { root.typography("fit-width",0); root.focus-reading(); } }
                PresetMark { x: root.knob-center-x + 22px * root.zoom-lift - self.width / 2;
                    y: root.knob-center-y + 21px * root.zoom-lift - self.height / 2; kind: 2; highlighted: root.preset-hover == self.kind; selected: root.pdf-zoom-stop == 2;
                    hover(v) => { if v { root.preset-hover = self.kind; } else if root.preset-hover == self.kind { root.preset-hover = -1; } }
                    clicked => { root.typography("fit-cover",0); root.focus-reading(); } }
            }
            ZoomGrip {
                x: root.dock-right - 100px; y: root.dock-top - root.dock-rise;
                width: 100px; height: root.dock-height + root.dock-rise;
                cx: root.knob-center-x; cy: root.knob-center-y; radius: root.knob-radius;
                marks-enabled: root.presets-ready && root.zoom-lift > 0.94;
                accessible-role: slider; accessible-label: "PDF 缩放"; accessible-value: round(root.pdf-zoom * 100) + "%";
                accessible-action-increment => { self.stepped(1); } accessible-action-decrement => { self.stepped(-1); }
                started(x,y,r) => { root.start-zoom(x,y,r); }
                motion(x,y,sx,sy) => { return root.zoom-motion(x,y,sx,sy); }
                released(x,y,d) => { root.release-zoom(x,y,d); }
                cancelled => { root.end-zoom(); root.preset-hover = -1; }
                opened(mark) => {
                    root.zoom-pinned = true;
                    if mark >= 0 { root.typography(mark == 0 ? "fit-page" : mark == 1 ? "fit-width" : "fit-cover",0); }
                }
                pointed(mark) => { root.preset-hover = mark; }
                stepped(d) => { root.typography("zoom",pow(1.12,d)); }
            }
        }
        if root.has-document && root.status != "": RaisedPanel {
            material: root.material; kind: FrostKind.notice;
            x: (parent.width - self.width) / 2; y: root.panel-top;
            width: min(parent.width - 2 * root.window-inset,520px); height: message.preferred-height + 24px;
            message := Text {
                x: 16px; y: 12px; width: parent.width - 32px;
                text: root.status; wrap: word-wrap;
                color: ReaderTheme.ink; font-size: 13px;
            }
        }
        if root.home-session || (!root.has-document && !root.opening-document): Frontispiece {
            width: parent.width; height: parent.height;
            message: root.opening-document || root.home-transition ? "" : root.status;
            variant: root.home-variant; frame: root.home-picture;
            departing: root.home-transition; dissolve: root.home-reveal-frame; progress: root.home-reveal-progress;
            book-drag-over: root.book-drag-over;
            negative(frame,rect,mono) => { root.negative-mark(frame,rect,mono) }
            tone(frame,x,y,w,h) => { root.cover-tone(frame,x,y,w,h) }
            open => { if !root.home-transition { root.open-file(); } }
        }
    }
}
