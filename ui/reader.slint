import { Slider, LineEdit, ComboBox, CheckBox, ScrollView, ListView, Palette } from "std-widgets.slint";

export struct Mark { x:float, y:float, w:float, h:float }
export struct TocRow { title:string, uri:string, depth:int, latin:bool }

export global ReaderTheme {
    in-out property <bool> dark: false;
    in-out property <color> paper: #f8f6f1;
    out property <color> chrome: dark ? #1b1f1d : #f3f4ef;
    out property <color> ink: dark ? #e7e9e5 : #262a27;
    out property <color> muted: dark ? #a1aaa2 : #707971;
    out property <color> line: dark ? #343b35 : #dde1d8;
    out property <color> accent: dark ? #a4c1aa : #506c60;
    out property <color> tint: dark ? #a4c1aa20 : #506c6016;
    out property <color> surface: dark ? #242a25 : #fcfcf8;
}

component QuietButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <string> label: root.text;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 32px; min-width: 44px;
    preferred-width: root.icon.width > 0 ? 34px : caption.preferred-width + 22px;
    horizontal-stretch: 0;
    border-radius: 6px;
    background: root.selected || touch.pressed ? ReaderTheme.tint : touch.has-hover ? ReaderTheme.tint : transparent;
    border-width: focus.has-focus ? 1px : 0px;
    border-color: ReaderTheme.accent;
    opacity: root.enabled ? 1 : 0.4;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    caption := Text {
        visible: root.icon.width == 0;
        text: root.text;
        color: root.selected ? ReaderTheme.accent : ReaderTheme.ink;
        font-size: 13px;
        min-width: 0px; overflow: elide;
        horizontal-alignment: center; vertical-alignment: center;
    }
    if root.icon.width > 0: Image {
        x: (parent.width - 18px) / 2; y: (parent.height - 18px) / 2;
        width: 18px; height: 18px; source: root.icon;
        colorize: root.selected ? ReaderTheme.accent : ReaderTheme.ink;
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                if root.enabled { root.clicked(); } return accept;
            }
            return reject;
        }
    }
    touch := TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.clicked(); } }
}

component SettingField inherits Rectangle {
    in property <string> label;
    in property <string> unit;
    in property <float> minimum;
    in property <float> maximum;
    in-out property <float> value;
    in property <bool> enabled: true;
    callback edited(float);
    callback entered(string);
    height: 63px;
    opacity: root.enabled ? 1 : 0.45;
    VerticalLayout {
        spacing: 3px;
        HorizontalLayout {
            Text { text: root.label; color: ReaderTheme.ink; font-size: 12px; horizontal-stretch: 1; }
            LineEdit {
                width: 59px; height: 27px; enabled: root.enabled;
                text: "" + (round(root.value * 100) / 100);
                accepted => { root.entered(self.text); }
            }
            Text { width: 28px; text: root.unit; color: ReaderTheme.muted; font-size: 11px; vertical-alignment: center; }
        }
        Slider {
            enabled: root.enabled; minimum: root.minimum; maximum: root.maximum;
            value <=> root.value;
            changed(v) => { root.edited(v); }
        }
    }
}

component PagePane inherits Rectangle {
    in property <image> source;
    in property <float> page-width;
    in property <float> page-height;
    in property <[Mark]> selection;
    in property <[Mark]> matches;
    in property <int> turn-mode: 0;
    in property <bool> pannable: false;
    callback select-text(float,float,float,float);
    callback hit(float,float);
    callback wheel(float);
    callback pan(float,float);
    callback wheel-xy(float,float,bool,bool);
    callback navigate(int);
    min-width: 0px; min-height: 0px;
    preferred-width: 0px; preferred-height: 0px;
    horizontal-stretch: 1; vertical-stretch: 1;
    clip: true;
    TouchArea {
        clicked => { root.navigate(root.turn-mode != 0 ? root.turn-mode : self.mouse-x < self.width / 2 ? -1 : 1); }
        scroll-event(event) => { root.wheel-xy(event.delta-x / 1px,event.delta-y / 1px,event.modifiers.shift,event.modifiers.control); return accept; }
    }
    image := Image {
        x: (parent.width - self.width) / 2;
        y: max(0px, (parent.height - self.height) / 2);
        width: root.page-width * 1px; height: root.page-height * 1px;
        source: root.source; image-fit: contain;
        for mark in root.matches: Rectangle {
            x: mark.x * 1px; y: mark.y * 1px; width: mark.w * 1px; height: mark.h * 1px;
            background: #c9aa3658;
        }
        for mark in root.selection: Rectangle {
            x: mark.x * 1px; y: mark.y * 1px; width: mark.w * 1px; height: mark.h * 1px;
            background: #648d7855;
        }
        touch := TouchArea {
            property <float> start-x;
            property <float> start-y;
            property <bool> dragging-pan;
            property <float> last-x;
            property <float> last-y;
            mouse-cursor: self.dragging-pan ? grabbing : default;
            pointer-event(event) => {
                if event.kind == PointerEventKind.cancel { self.dragging-pan = false; }
                if event.kind == PointerEventKind.down && (event.button == PointerEventButton.middle || event.button == PointerEventButton.right) && root.pannable {
                    self.dragging-pan = true;
                    self.last-x = self.mouse-x / 1px; self.last-y = self.mouse-y / 1px;
                }
                if event.kind == PointerEventKind.up && (event.button == PointerEventButton.middle || event.button == PointerEventButton.right) { self.dragging-pan = false; }
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    self.start-x = self.mouse-x / 1px; self.start-y = self.mouse-y / 1px;
                }
                if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                    if abs(self.mouse-x / 1px - self.start-x) + abs(self.mouse-y / 1px - self.start-y) < 4 {
                        root.hit(self.mouse-x / 1px,self.mouse-y / 1px);
                    } else {
                        root.select-text(self.start-x,self.start-y,self.mouse-x / 1px,self.mouse-y / 1px);
                    }
                }
            }
            moved => {
                if self.dragging-pan {
                    root.pan(self.last-x - self.mouse-x / 1px,self.last-y - self.mouse-y / 1px);
                    self.last-x = self.mouse-x / 1px; self.last-y = self.mouse-y / 1px;
                }
            }
            scroll-event(event) => { root.wheel-xy(event.delta-x / 1px,event.delta-y / 1px,event.modifiers.shift,event.modifiers.control); return accept; }
        }
    }
}

component ZoomDial inherits Rectangle {
    in property <float> value: 1;
    in property <int> stop: 0;
    callback adjusted(float);
    callback reset();
    callback active(bool);
    width: 100px; height: 36px;
    border-radius: 6px;
    background: touch.has-hover || touch.pressed || dial-focus.has-focus ? ReaderTheme.tint : transparent;
    forward-focus: dial-focus;
    accessible-role: slider; accessible-label: "缩放";
    accessible-value: round(root.value * 100) + "%" + (root.stop == 1 ? " 整页" : root.stop == 2 ? " 铺满" : "");
    accessible-action-increment => { root.adjusted(1); }
    accessible-action-decrement => { root.adjusted(-1); }
    // Direct geometry is crisp in the software renderer. The needle interpolates
    // only for 110ms after input; no perpetual clock or rotating bitmap.
    property <angle> angle: log(root.value,2) * 270deg - 90deg;
    animate angle { duration: touch.pressed ? 0ms : 110ms; easing: ease-out; }
    Rectangle {
        x: 5px; y: 6px; width: 24px; height: 24px;
        border-radius: 12px; border-width: 1px;
        border-color: root.stop != 0 ? ReaderTheme.accent : ReaderTheme.muted;
        background: root.stop != 0 ? ReaderTheme.tint : transparent;
    }
    Path {
        x: 1px; y: 2px; width: 32px; height: 32px;
        viewbox-width: 32; viewbox-height: 32;
        stroke: ReaderTheme.accent; stroke-width: 1.8px;
        MoveTo { x: 16 + 3 * cos(root.angle); y: 16 + 3 * sin(root.angle); }
        LineTo { x: 16 + 8.2 * cos(root.angle); y: 16 + 8.2 * sin(root.angle); }
    }
    Rectangle { x: 15.5px; y: 16.5px; width: 3px; height: 3px; border-radius: 1.5px; background: ReaderTheme.accent; }
    Text { x: 37px; y: root.stop != 0 ? 2px : 0px; width: 59px; height: root.stop != 0 ? 19px : parent.height; text: round(root.value * 100) + "%"; color: ReaderTheme.ink; font-size: 12px; font-family: "Segoe UI"; vertical-alignment: center; }
    if root.stop != 0: Text { x: 37px; y: 20px; height: 13px; text: root.stop == 1 ? "整页" : "铺满"; color: ReaderTheme.muted; font-size: 9px; }
    dial-focus := FocusScope {
        key-pressed(e) => {
            if e.text == Key.RightArrow || e.text == Key.UpArrow { root.adjusted(1); return accept; }
            if e.text == Key.LeftArrow || e.text == Key.DownArrow { root.adjusted(-1); return accept; }
            if e.text == Key.Home || e.text == Key.Return { root.reset(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        property <float> last-x;
        property <float> last-y;
        property <angle> last-angle;
        property <bool> angular;
        property <float> travel;
        mouse-cursor: ew-resize;
        pointer-event(e) => {
            if e.kind == PointerEventKind.cancel { root.active(false); }
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                dial-focus.focus(); root.active(true); self.travel = 0;
                self.last-x = self.mouse-x / 1px; self.last-y = self.mouse-y / 1px;
                let dx = self.last-x - 17; let dy = self.last-y - 18;
                self.angular = dx*dx + dy*dy >= 36 && dx*dx + dy*dy <= 256;
                self.last-angle = atan2(dy,dx);
            }
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.left { root.active(false); if self.travel < 3 { root.reset(); } }
        }
        moved => {
            if self.pressed {
                let dx = self.mouse-x / 1px - self.last-x; let dy = self.mouse-y / 1px - self.last-y;
                self.travel += abs(dx) + abs(dy);
                if self.angular {
                    let x = self.mouse-x / 1px - 17; let y = self.mouse-y / 1px - 18;
                    if x*x + y*y >= 9 {
                        let angle = atan2(y,x); let delta = angle - self.last-angle;
                        root.adjusted(((delta > 180deg ? delta - 360deg : delta < -180deg ? delta + 360deg : delta) / 270deg) * log(2,1.12));
                        self.last-angle = angle;
                    }
                } else { root.adjusted((dx - dy)/24); }
                self.last-x = self.mouse-x / 1px; self.last-y = self.mouse-y / 1px;
            }
        }
        scroll-event(e) => { root.adjusted(e.delta-y / 120px); return accept; }
    }
}

component PageScrubber inherits Rectangle {
    in property <float> value;
    in property <string> label;
    callback sought(float);
    callback turned(int);
    callback active(bool);
    property <float> preview: value;
    height: 36px;
    accessible-role: slider; accessible-label: "阅读进度";
    accessible-value: root.label;
    accessible-action-increment => { root.turned(1); }
    accessible-action-decrement => { root.turned(-1); }
    Text { x: 4px; width: 116px; text: root.label; color: ReaderTheme.ink; font-family: "Segoe UI"; font-size: 12px; vertical-alignment: center; }
    track := Rectangle {
        x: 132px; y: (parent.height - 3px) / 2; width: max(20px,parent.width - 144px); height: 3px;
        border-radius: 1.5px; background: ReaderTheme.line;
        Rectangle { x: 0px; y: 0px; width: parent.width * clamp(touch.pressed ? root.preview : root.value,0,1); height: parent.height; background: ReaderTheme.accent; border-radius: 1.5px; }
        Rectangle { x: clamp(touch.pressed ? root.preview : root.value,0,1) * parent.width - 4px; y: -2.5px; width: 8px; height: 8px; border-radius: 4px; background: ReaderTheme.accent; }
    }
    touch := TouchArea {
        x: 124px; width: parent.width - self.x;
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.cancel { root.active(false); }
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.active(true); root.preview = clamp((self.mouse-x - 8px) / track.width,0,1); }
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.left { root.active(false); root.sought(clamp((self.mouse-x - 8px) / track.width,0,1)); }
        }
        moved => { if self.pressed { root.preview = clamp((self.mouse-x - 8px) / track.width,0,1); } }
        scroll-event(e) => { if e.delta-y != 0px { root.turned(e.delta-y < 0px ? 1 : -1); } return accept; }
    }
}

export component ReaderWindow inherits Window {
    title: root.book-title == "" ? "Sae Reader" : root.book-title + " · Sae Reader";
    icon: @image-url("../assets/window-icon.png");
    preferred-width: 1180px; preferred-height: 840px;
    min-width: 640px; min-height: 480px;
    default-font-family: "Microsoft YaHei UI";
    background: ReaderTheme.chrome;
    in-out property <bool> dark <=> ReaderTheme.dark;
    in-out property <color> canvas-color <=> ReaderTheme.paper;
    in property <int> design-variant: 0;
    init => { Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }
    changed dark => { Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }

    in property <image> page-image;
    in property <image> right-image;
    in property <string> book-title: "";
    in property <string> status: "";
    in property <string> notice: "";
    in property <string> page-label: "";
    in property <float> progress: 0;
    in property <bool> has-document: false;
    in property <bool> reflowable: true;
    in property <float> image-width: 0;
    in property <float> image-height: 0;
    in property <float> right-width: 0;
    in property <float> right-height: 0;
    in property <[Mark]> highlights;
    in property <[Mark]> right-highlights;
    in property <[Mark]> search-marks;
    in property <[Mark]> right-search-marks;
    in property <[TocRow]> contents;
    in-out property <string> selected-content-uri;
    in property <[string]> fonts;
    in property <string> family-label: "默认衬线";
    in-out property <int> theme-index: 0;
    in-out property <bool> double-page: false;
    in-out property <bool> show-contents: false;
    in-out property <bool> show-settings: false;
    in-out property <bool> show-search: false;
    in-out property <bool> show-toolbar: false;
    in-out property <bool> top-hover: false;
    in-out property <bool> bottom-hover: false;
    in-out property <bool> is-fullscreen: false;
    in-out property <bool> controls-busy: false;
    out property <bool> top-visible: !root.has-document || root.show-toolbar || root.top-hover || root.show-search;
    out property <bool> bottom-visible: root.has-document && (root.show-progress || !root.reflowable) && (root.show-toolbar || root.bottom-hover || root.controls-busy);
    in-out property <bool> show-progress: true;
    in-out property <bool> justified: false;
    in-out property <float> font-size-pt: 18;
    in-out property <float> line-height: 1.55;
    in-out property <float> paragraph-before: 0;
    in-out property <float> paragraph-after: 0.6;
    in-out property <float> indent: 1.5;
    in-out property <float> text-width: 720;
    in-out property <float> margin-top: 28;
    in-out property <float> margin-right: 40;
    in-out property <float> margin-bottom: 28;
    in-out property <float> margin-left: 40;
    out property <float> viewport-width: max(0,canvas.width / 1px - 32);
    out property <float> viewport-height: canvas.height / 1px;
    in property <bool> effective-spread: false;
    in property <string> search-status: "";
    in property <float> pdf-zoom: 1;
    in property <float> pdf-fit-width-zoom: 1;
    in property <float> pdf-fill-zoom: 1;
    in property <int> pdf-zoom-stop: 1;
    in property <bool> pdf-pannable: false;
    in property <int> page-color: 0;
    in property <bool> text-document: false;
    in property <string> encoding-label: "";
    in property <string> encoding-choice: "自动检测";
    callback open-file(); callback next-page(int); callback back();
    callback typography(string,float); callback resized(); callback follow-link(string);
    callback setting-text(string,string); callback mode-changed(bool); callback theme-changed(int);
    callback fonts-needed(); callback wheel(float);
    callback select-text(int,float,float,float,float); callback hit(int,float,float); callback copy-text();
    callback search(string); callback search-next(int); callback fullscreen();
    callback pan(float,float); callback encoding-changed(string); callback page-color-changed(int);
    callback wheel-xy(float,float,bool,bool); callback seek(float);
    public function dismiss-panels() {
        root.show-contents = false; root.show-settings = false; root.show-search = false;
        root.show-toolbar = false; root.search(""); keyboard.focus();
    }
    public function focus-search() { root.show-settings = false; root.show-contents = false; root.show-search = true; query.focus(); }
    changed viewport-width => { root.resized(); }
    changed viewport-height => { root.resized(); }
    changed show-settings => { if root.show-settings && root.reflowable { root.fonts-needed(); } }
    forward-focus: keyboard;

    keyboard := FocusScope {
        // Reading navigation survives toolbar/dial focus. Editable panels keep
        // their own cursor and list keys; no native event hook or polling.
        capture-key-pressed(event) => {
            if root.has-document && !root.show-search && !root.show-settings && !root.show-contents && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta {
                if event.text == Key.RightArrow || event.text == Key.PageDown { root.next-page(1); return accept; }
                if event.text == Key.LeftArrow || event.text == Key.PageUp { root.next-page(-1); return accept; }
            }
            return reject;
        }
        key-pressed(event) => {
            if event.modifiers.control && (event.text == "o" || event.text == "O") { root.open-file(); return accept; }
            if event.modifiers.control && (event.text == "f" || event.text == "F") { root.focus-search(); return accept; }
            if event.modifiers.control && (event.text == "c" || event.text == "C") { root.copy-text(); return accept; }
            if !root.show-contents && !root.show-settings && !root.show-search {
                if event.text == Key.RightArrow || event.text == Key.PageDown || event.text == " " { root.next-page(1); return accept; }
                if event.text == Key.LeftArrow || event.text == Key.PageUp { root.next-page(-1); return accept; }
            }
            if event.text == Key.Escape { root.dismiss-panels(); return accept; }
            if event.text == Key.F11 { root.fullscreen(); return accept; }
            if event.text == Key.F10 { root.show-toolbar = !root.show-toolbar; return accept; }
            if !root.show-contents && !root.show-search && !root.show-settings && event.text == Key.UpArrow { if root.pdf-pannable { root.pan(0,-120); } else { root.next-page(-1); } return accept; }
            if !root.show-contents && !root.show-search && !root.show-settings && event.text == Key.DownArrow { if root.pdf-pannable { root.pan(0,120); } else { root.next-page(1); } return accept; }
            if event.modifiers.control && (event.text == "+" || event.text == "=") { root.typography("delta-size",1); return accept; }
            if event.modifiers.control && event.text == "-" { root.typography("delta-size",-1); return accept; }
            if event.modifiers.control && event.text == "0" { root.typography("size",18); return accept; }
            return reject;
        }

        canvas := Rectangle {
            background: ReaderTheme.paper; clip: true;
            if !root.has-document: VerticalLayout {
                alignment: center; spacing: 24px;
                Text { text: "Sae"; font-family: "Segoe UI"; font-size: 48px; color: ReaderTheme.accent; horizontal-alignment: center; }
                HorizontalLayout { alignment: center;
                    QuietButton { text: "打开书籍"; selected: true; clicked => { root.open-file(); } }
                }
                Text { text: "EPUB · PDF · TXT · Markdown · AZW3 · MOBI · FB2"; color: ReaderTheme.muted; font-size: 11px; horizontal-alignment: center; }
            }
            if root.has-document: HorizontalLayout {
                spacing: root.effective-spread ? 32px : 0px;
                padding-left: 16px; padding-right: 16px;
                PagePane {
                    source: root.page-image; page-width: root.image-width; page-height: root.image-height;
                    selection: root.highlights; matches: root.search-marks; pannable: root.pdf-pannable;
                    turn-mode: root.effective-spread ? -1 : 0;
                    select-text(a,b,c,d) => { keyboard.focus(); root.select-text(0,a,b,c,d); }
                    hit(a,b) => { keyboard.focus(); root.hit(0,a,b); }
                    wheel-xy(x,y,s,c) => { root.wheel-xy(x,y,s,c); }
                    pan(x,y) => { root.pan(x,y); }
                    navigate(d) => { keyboard.focus(); root.next-page(d); }
                }
                if root.effective-spread: PagePane {
                    source: root.right-image; page-width: root.right-width; page-height: root.right-height;
                    selection: root.right-highlights; matches: root.right-search-marks; pannable: root.pdf-pannable;
                    turn-mode: 1;
                    select-text(a,b,c,d) => { keyboard.focus(); root.select-text(1,a,b,c,d); }
                    hit(a,b) => { keyboard.focus(); root.hit(1,a,b); }
                    wheel-xy(x,y,s,c) => { root.wheel-xy(x,y,s,c); }
                    pan(x,y) => { root.pan(x,y); }
                    navigate(d) => { keyboard.focus(); root.next-page(d); }
                }
            }
        }

        // These panels overlay a stable full-size reading canvas. Hovering does
        // not invoke native pagination, resize the page or allocate new images.
        header := Rectangle {
            x: 12px; y: 12px; width: parent.width - 24px; height: 52px;
            visible: root.top-visible;
            background: ReaderTheme.surface; border-radius: 9px;
            border-width: 1px; border-color: ReaderTheme.line;
            TouchArea {}
            HorizontalLayout {
                padding-left: 14px; padding-right: 8px; padding-top: 10px; padding-bottom: 10px; spacing: 4px;
                Rectangle { width: 2px; height: 16px; y: 8px; background: ReaderTheme.accent; }
                Text { width: 46px; text: "Sae"; font-size: 17px; font-family: "Segoe UI"; font-weight: 600; color: ReaderTheme.ink; vertical-alignment: center; }
                QuietButton { icon: @image-url("../assets/icons/open.svg"); label: "打开书籍"; clicked => { root.open-file(); } }
                Rectangle { width: 1px; height: 16px; y: 8px; background: ReaderTheme.line; }
                Text { text: root.book-title; font-size: 12px; color: ReaderTheme.muted; horizontal-stretch: 1; min-width: 0px; overflow: elide; vertical-alignment: center; }
                if root.width > 850px: QuietButton { text: "返回"; enabled: root.has-document; clicked => { root.back(); } }
                QuietButton { icon: @image-url("../assets/icons/contents.svg"); label: "目录"; selected: root.show-contents; enabled: root.has-document; clicked => { root.show-contents = !root.show-contents; root.show-settings = false; root.show-search = false; if !root.show-contents { keyboard.focus(); } } }
                QuietButton { icon: @image-url("../assets/icons/search.svg"); label: "全文查找"; selected: root.show-search; enabled: root.has-document; clicked => { if root.show-search { root.show-search = false; } else { root.focus-search(); } } }
                Rectangle { width: 8px; }
                Rectangle {
                    width: 96px; height: 32px; border-radius: 6px; background: ReaderTheme.tint;
                    HorizontalLayout { padding: 2px; spacing: 0px;
                        QuietButton { min-width: 44px; text: "单页"; selected: !root.double-page; clicked => { root.double-page = false; root.mode-changed(false); keyboard.focus(); } }
                        QuietButton { min-width: 44px; text: "双页"; selected: root.double-page; clicked => { root.double-page = true; root.mode-changed(true); keyboard.focus(); } }
                    }
                }
                QuietButton { icon: @image-url("../assets/icons/settings.svg"); label: "阅读设置"; selected: root.show-settings; clicked => { root.show-settings = !root.show-settings; root.show-contents = false; root.show-search = false; if !root.show-settings { keyboard.focus(); } } }
                Rectangle { width: 1px; height: 16px; y: 8px; background: ReaderTheme.line; }
                QuietButton { icon: @image-url("../assets/icons/fullscreen.svg"); label: root.is-fullscreen ? "退出全屏" : "全屏"; selected: root.is-fullscreen; clicked => { root.fullscreen(); } }
            }
        }
        searchbar := Rectangle {
            visible: root.show-search;
            x: max(12px,parent.width - 572px); y: 72px; width: min(560px,parent.width - 24px); height: 48px;
            background: ReaderTheme.surface; border-radius: 8px; border-width: 1px; border-color: ReaderTheme.line;
            TouchArea {}
            HorizontalLayout {
                padding: 8px; spacing: 4px;
                query := LineEdit { placeholder-text: "搜索全文"; accepted => { root.search(self.text); } }
                QuietButton { text: "查找"; clicked => { root.search(query.text); } }
                QuietButton { text: "上处"; clicked => { root.search-next(-1); } }
                QuietButton { text: "下处"; clicked => { root.search-next(1); } }
                QuietButton { text: "×"; label: "关闭查找"; clicked => { root.show-search = false; root.search(""); keyboard.focus(); } }
            }
        }
        if root.show-contents: Rectangle {
            x: 12px; y: 76px; width: min(clamp(parent.width * 0.28,280px,340px),parent.width - 24px); height: parent.height - 152px;
            background: ReaderTheme.surface; border-radius: 10px; border-width: 1px; border-color: ReaderTheme.line;
            clip: true;
            TouchArea {}
            VerticalLayout {
                padding: 12px; spacing: 8px;
                HorizontalLayout {
                    Text { text: "目录"; font-family: "Microsoft YaHei"; font-size: 14px; font-weight: 400; color: ReaderTheme.muted; vertical-alignment: center; horizontal-stretch: 1; }
                    QuietButton { text: "×"; label: "关闭目录"; clicked => { root.show-contents = false; keyboard.focus(); } }
                }
                Rectangle { height: 1px; background: ReaderTheme.line; }
                ListView {
                    horizontal-scrollbar-policy: always-off;
                    content-width: self.visible-width;
                    for row in root.contents: Rectangle {
                    // ListView instantiates visible rows only. A growing title
                    // gets its real height and never shares the scrollbar lane.
                    width: parent.width - 16px; height: max(42px,toc-title.preferred-height + 18px); border-radius: 5px;
                    background: row.uri == root.selected-content-uri || toc-touch.has-hover || toc-focus.has-focus ? ReaderTheme.tint : transparent;
                    accessible-role: button; accessible-label: row.title;
                    accessible-action-default => { root.follow-link(row.uri); root.show-contents = false; keyboard.focus(); }
                    forward-focus: toc-focus;
                    if row.uri == root.selected-content-uri || toc-focus.has-focus: Rectangle { x: 0px; y: 12px; width: 2px; height: parent.height - 24px; background: ReaderTheme.accent; }
                    toc-title := Text {
                        x: 10px + min(row.depth,5) * 12px; y: 9px;
                        width: parent.width - self.x - 8px; height: self.preferred-height;
                        text: row.title; wrap: word-wrap; vertical-alignment: top;
                        font-family: row.latin ? "Segoe UI" : "Microsoft YaHei";
                        font-size: row.depth == 0 ? 14px : 13px; font-weight: 400;
                        color: row.uri == root.selected-content-uri || toc-touch.has-hover ? ReaderTheme.accent : ReaderTheme.ink;
                    }
                    toc-focus := FocusScope { key-pressed(e) => { if e.text == Key.Return || e.text == " " { root.follow-link(row.uri); root.show-contents = false; keyboard.focus(); return accept; } return reject; } }
                    toc-touch := TouchArea { mouse-cursor: pointer; clicked => { root.follow-link(row.uri); root.show-contents = false; keyboard.focus(); } }
                } }
            }
        }
                if root.show-settings: Rectangle {
                    x: max(12px,root.width - 316px); y: 76px;
                    width: 304px; height: root.height - 152px;
                    background: ReaderTheme.surface; border-radius: 10px;
                    border-width: 1px; border-color: ReaderTheme.line;
                    TouchArea {}
                    Rectangle { x: 0px; y: 0px; width: 1px; background: ReaderTheme.line; }
                    ScrollView {
                        x: 18px; y: 12px; width: parent.width - 36px; height: parent.height - 24px;
                        VerticalLayout {
                            spacing: 10px;
                            HorizontalLayout {
                                Text { text: "阅读排版"; font-size: 14px; font-weight: 500; color: ReaderTheme.ink; horizontal-stretch: 1; vertical-alignment: center; }
                                QuietButton { text: "收起"; clicked => { root.show-settings=false; } }
                            }
                            Text { text: "主题"; color: ReaderTheme.muted; font-size: 11px; }
                            HorizontalLayout {
                                spacing: 4px;
                                QuietButton { text: "暖纸"; selected: root.theme-index==0; clicked => { root.theme-changed(0); } }
                                QuietButton { text: "白纸"; selected: root.theme-index==1; clicked => { root.theme-changed(1); } }
                                QuietButton { text: "夜读"; selected: root.theme-index==2; clicked => { root.theme-changed(2); } }
                            }
                            Rectangle { height: 1px; background: ReaderTheme.line; }
                            Text { text: root.reflowable ? "文字" : "页面外观"; color: ReaderTheme.muted; font-size: 11px; wrap: word-wrap; }
                            if root.reflowable: VerticalLayout {
                                spacing: 10px;
                            ComboBox { enabled: root.reflowable; model: root.fonts; current-value: root.family-label; selected(value) => { root.setting-text("family",value); } }
                            SettingField { label: "字号"; unit: "pt"; minimum:12; maximum:36; value <=> root.font-size-pt; enabled:root.reflowable; edited(v)=>{root.typography("size",v);} entered(s)=>{root.setting-text("size",s);} }
                            SettingField { label: "行距"; unit: "倍"; minimum:1.15; maximum:2.2; value <=> root.line-height; enabled:root.reflowable; edited(v)=>{root.typography("line",v);} entered(s)=>{root.setting-text("line",s);} }
                            Text { text: "段落"; color: ReaderTheme.muted; font-size: 11px; }
                            SettingField { label: "段前"; unit: "em"; minimum:0; maximum:2; value <=> root.paragraph-before; enabled:root.reflowable; edited(v)=>{root.typography("before",v);} entered(s)=>{root.setting-text("before",s);} }
                            SettingField { label: "段后"; unit: "em"; minimum:0; maximum:2; value <=> root.paragraph-after; enabled:root.reflowable; edited(v)=>{root.typography("paragraph",v);} entered(s)=>{root.setting-text("paragraph",s);} }
                            SettingField { label: "首行缩进"; unit: "em"; minimum:0; maximum:2.5; value <=> root.indent; enabled:root.reflowable; edited(v)=>{root.typography("indent",v);} entered(s)=>{root.setting-text("indent",s);} }
                            CheckBox { text: "两端对齐"; enabled:root.reflowable; checked <=> root.justified; toggled => {root.typography("justify",self.checked?1:0);} }
                            Text { text: "页面"; color: ReaderTheme.muted; font-size: 11px; }
                            SettingField { label: "正文宽度"; unit: "px"; minimum:260; maximum:1200; value <=> root.text-width; enabled:root.reflowable; edited(v)=>{root.typography("width",v);} entered(s)=>{root.setting-text("width",s);} }
                            SettingField { label: "上边距"; unit: "pt"; minimum:0; maximum:100; value <=> root.margin-top; enabled:root.reflowable; edited(v)=>{root.typography("top",v);} entered(s)=>{root.setting-text("top",s);} }
                            SettingField { label: "下边距"; unit: "pt"; minimum:0; maximum:100; value <=> root.margin-bottom; enabled:root.reflowable; edited(v)=>{root.typography("bottom",v);} entered(s)=>{root.setting-text("bottom",s);} }
                            SettingField { label: "左边距"; unit: "pt"; minimum:0; maximum:100; value <=> root.margin-left; enabled:root.reflowable; edited(v)=>{root.typography("left",v);} entered(s)=>{root.setting-text("left",s);} }
                            SettingField { label: "右边距"; unit: "pt"; minimum:0; maximum:100; value <=> root.margin-right; enabled:root.reflowable; edited(v)=>{root.typography("right",v);} entered(s)=>{root.setting-text("right",s);} }
                            }
                            if !root.reflowable: ComboBox {
                                model: ["原色","随主题着色","反色"]; current-index: root.page-color;
                                selected(v) => { root.page-color-changed(self.current-index); }
                            }
                            if root.text-document: VerticalLayout {
                                spacing: 6px;
                                Text { text: "文本编码"; color: ReaderTheme.muted; font-size: 11px; }
                                ComboBox { current-value: root.encoding-choice; model: ["自动检测","UTF-8","UTF-16LE","UTF-16BE","GB18030","Big5","Shift_JIS","windows-1252"]; selected(v) => { root.encoding-changed(v); } }
                                Text { text: root.encoding-label; color: ReaderTheme.muted; font-size: 11px; }
                            }
                            CheckBox { text: "显示阅读进度"; checked <=> root.show-progress; toggled=>{root.typography("progress",self.checked?1:0);} }

                            QuietButton { text: "恢复默认排版"; clicked=>{root.typography("reset",0);} }
                        }
                    }
                }

        if root.bottom-visible: Rectangle {
            x: (parent.width - self.width) / 2; y: parent.height - 70px;
            width: min(root.reflowable ? 390px : root.show-progress ? 560px : 170px,parent.width - 24px); height: 54px;
            background: ReaderTheme.surface; border-radius: 10px; border-width: 1px; border-color: ReaderTheme.line;
            TouchArea {}
            HorizontalLayout {
                padding: 9px; spacing: 8px;
                if root.show-progress: PageScrubber { value: root.progress; label: root.page-label; horizontal-stretch: 1;
                    sought(v) => { root.seek(v); } turned(d) => { root.next-page(d); }
                    active(v) => { root.controls-busy = v; }
                }
                if !root.reflowable && root.show-progress: Rectangle { width: 1px; height: 20px; y: 8px; background: ReaderTheme.line; }
                if !root.reflowable: ZoomDial { value: root.pdf-zoom; stop: root.pdf-zoom-stop; adjusted(d) => { root.typography("zoom",pow(1.12,d)); } reset => { root.typography("fit-page",0); } active(v) => { root.controls-busy = v; } }
                if !root.reflowable: QuietButton { text: "适宽"; clicked => { root.typography("fit-width",0); } }
            }
        }
        if root.status != "" || (root.show-search && root.search-status != "") || (root.top-visible && root.notice != ""): Rectangle {
            x: 20px; y: parent.height - 112px; width: min(message.preferred-width + 24px,parent.width - 40px); height: 28px;
            background: ReaderTheme.surface; border-radius: 6px;
            message := Text {
                x: 12px; width: parent.width - 24px;
                text: root.status != "" ? root.status : root.show-search ? root.search-status : root.notice;
                color: ReaderTheme.muted; font-size: 11px; overflow: elide; vertical-alignment: center;
            }
        }
    }
}
