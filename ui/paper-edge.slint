// Lower-left paper triangle. Opaque spans use Slint's solid fill; only the
// narrow diagonal within each strip needs antialiasing.
export component PaperEdge inherits Rectangle {
    in property <color> paper;
    pure function pixel(y: length) -> length { return round(y/1phx)*1phx; }
    for i in ceil(root.height/48px): strip := Rectangle {
        y: root.pixel(i*48px); width: root.width;
        height: min(root.height,root.pixel((i + 1)*48px)) - self.y;
        property <length> top-edge: self.y/root.height*root.width;
        property <length> foot: (self.y + self.height)/root.height*root.width;
        property <length> solid: floor(self.top-edge/1phx)*1phx;
        Rectangle { x: 0px; width: strip.solid; height: strip.height; background: root.paper; }
        wedge := Path {
            // One pixel inside the solid span prevents seams at fractional DPI.
            x: strip.solid - 1phx; width: strip.foot - self.x; height: strip.height;
            viewbox-width: self.width/1px; viewbox-height: self.height/1px;
            MoveTo { x: 0; y: 0; } LineTo { x: (strip.top-edge - wedge.x)/1px; y: 0; }
            LineTo { x: wedge.viewbox-width; y: wedge.viewbox-height; }
            LineTo { x: 0; y: wedge.viewbox-height; } Close {}
            fill: root.paper;
        }
    }
}
